@@ -0,0 +1,262 @@
+class_name Venues
+extends RefCounted
+## What you can do at places in the city (bar, club, gym, diner, corner shop,
+## training ground, arena) and the people you meet there. The walkable rooms
+## are data/venues/<id>.json (built by art/venues/venues.py) shown by the home
+## scene; the rules live here so tests can drive them without a scene.
+
+const DIR := "res://data/venues/"
+const IDS := ["bar", "club", "gym", "diner", "shop", "training", "arena"]
+
+## Activities: slots used, need changes, cost, a stat to train (once a day).
+const ACT := {
+	"dance": {"slots": 1, "energy": -12.0, "fun": 18.0, "social": 10.0, "text": "You dance for a couple of hours."},
+	"hangout": {"slots": 1, "fun": 8.0, "social": 14.0, "energy": -3.0, "text": "You hang out and talk for a while."},
+	"watch": {"slots": 1, "fun": 10.0, "social": 6.0, "text": "You watch a pro match on the big screen with the regulars."},
+	"arcade": {"slots": 0, "cost": 5, "fun": 6.0, "text": "A few credits on the arcade machine."},
+	"workout": {"slots": 1, "energy": -15.0, "fun": 6.0, "hunger": -8.0, "stat": "movement", "gain": 0.2, "text": "A proper workout."},
+	"sauna": {"slots": 1, "energy": 10.0, "fun": 5.0, "hangover": -30.0, "text": "You sweat it out in the sauna."},
+	"shower": {"slots": 0, "energy": 4.0, "hangover": -10.0, "text": "A cold shower. You feel almost human."},
+	"eat": {"slots": 1, "cost": 18, "hunger": 65.0, "fun": 4.0, "text": "A big plate of food."},
+	"coffee": {"slots": 0, "cost": 4, "energy": 12.0, "text": "A strong coffee."},
+	"eat_free": {"slots": 0, "hunger": 40.0, "text": "You grab something from the team kitchen."},
+	"review": {"slots": 1, "fun": 2.0, "stat": "decision", "gain": 0.15, "text": "You go through demos with the analysts."},
+	"vip": {"slots": 1, "fun": 15.0, "social": 15.0, "energy": -5.0, "fame": 400, "text": "Bottles in the VIP booth."},
+	"dj": {"slots": 0, "cost": 20, "fun": 5.0, "text": "The DJ plays your request. The floor goes off."},
+	"toilet": {"slots": 0, "text": ""},
+}
+
+const PATRON_FIRST := ["Sam", "Alex", "Jordan", "Riley", "Casey", "Mia", "Leo", "Noah", "Ava", "Kai", "Zoe", "Max", "Ivy", "Theo", "Nina", "Omar", "Lena", "Jay"]
+const FAN_LINES := ["No way, it's you! Can I get a photo?", "Your clutch last week was insane.", "Sign my shirt? Please?",
+	"My little brother has your poster on his wall.", "You're way taller in real life."]
+const LOCAL_LINES := ["Busy tonight, huh?", "You look familiar. Do you play darts?", "This place used to be a lot quieter.",
+	"Don't get the house wine. Trust me.", "I'm just here for the wings."]
+
+
+static func data(id: String) -> Dictionary:
+	return Home.load_json(DIR + id + ".json")
+
+
+static func name_of(id: String) -> String:
+	return String(data(id).get("name", id.capitalize()))
+
+
+## Open in this slot?
+static func is_open(id: String, slot: int) -> bool:
+	for s in data(id).get("open", [0, 1, 2, 3]):
+		if int(s) == slot:
+			return true
+	return false
+
+
+static func hours_text(id: String) -> String:
+	var o: Array = data(id).get("open", [0, 1, 2, 3])
+	if o.size() >= 4:
+		return "Open all day and night"
+	return "Open: " + ", ".join(o.map(func(s: Variant) -> String: return String(LifeSim.SLOTS[int(s)]).to_lower()))
+
+
+## Do a venue activity. Returns {ok, text}.
+static func act(w: World, use: String) -> Dictionary:
+	var sim := w.life().sim
+	if not ACT.has(use):
+		return {"ok": false, "text": ""}
+	var a: Dictionary = ACT[use]
+	if use == "vip" and w.fame < 50000:
+		return {"ok": false, "text": "The bouncer looks at you. \"VIP is for people we've heard of.\" (50k followers)"}
+	if a.has("stat") and sim.done_today(use):
+		return {"ok": false, "text": "You've already done that today."}
+	var cost := int(a.get("cost", 0))
+	if use == "vip":
+		cost = 400
+	if w.wallet < cost:
+		return {"ok": false, "text": "You can't afford that ($%d)." % cost}
+	w.wallet -= cost
+	var t := String(a.text)
+	for k in ["energy", "hunger", "fun", "social"]:
+		if a.has(k):
+			sim.add_need(k, float(a[k]))
+	if a.has("hangover"):
+		sim.hangover = maxf(0.0, sim.hangover + float(a.hangover))
+	if a.has("stat"):
+		sim.mark_today(use)
+		var key := String(a.stat)
+		if use == "review" and w.rng.randf() < 0.5:
+			key = "positioning"
+		var gain := float(a.gain) * (0.5 if sim.hangover > 40.0 or sim.drunk > 30.0 else 1.0)
+		var d := Progression.train(w.user_player, key, w.rng, gain, gain * 0.5)
+		t += " %s %+.2f." % [PlayerData.STAT_NAMES.get(key, key), d]
+	if a.has("fame"):
+		w._gain_fame(int(a.fame))
+	if use == "dance" and sim.drunk > 70.0 and w.rng.randf() < 0.2:
+		t += " You fall over on the dance floor. Someone is definitely filming."
+		w._post(w._fan_handle(), "%s absolutely wiped out on the dance floor at Pulse lmaooo" % w.user_player.player_name, "fan", 1.4)
+	if use == "toilet":
+		if sim.drunk >= 50.0:
+			sim.drunk = maxf(0.0, sim.drunk - 12.0)
+			sim.hunger = maxf(0.0, sim.hunger - 20.0)
+			t = "You throw up. Sobering, in a way."
+		else:
+			t = "You splash some water on your face."
+	sim.spend(int(a.get("slots", 0)))
+	Game.save_player_career_soon()
+	return {"ok": true, "text": t}
+
+
+## A drink at the bar. Every third drink in a slot, time moves on.
+static func drink(w: World, id: String) -> Dictionary:
+	var sim := w.life().sim
+	var r := sim.consume(id, false)
+	if bool(r.ok):
+		var k := "drinks_%d" % sim.abs_slot()
+		sim.used[k] = int(sim.used.get(k, 0)) + 1
+		if int(sim.used[k]) % 3 == 0:
+			sim.spend(1)
+			r.text = String(r.text) + " (Time flies: it's %s.)" % sim.short_time().to_lower()
+	return r
+
+
+## Corner shop: packs into your stash, snacks, energy drinks.
+static func shop_buy(w: World, what: String) -> String:
+	var sim := w.life().sim
+	match what:
+		"snack":
+			return sim.eat(25.0, 6)
+		"energy":
+			if w.wallet < 5:
+				return "Need $5"
+			w.wallet -= 5
+			sim.energy = minf(100.0, sim.energy + 15.0)
+			return ""
+		"water":
+			if w.wallet < 2:
+				return "Need $2"
+			w.wallet -= 2
+			sim.hangover = maxf(0.0, sim.hangover - 12.0)
+			return ""
+	return sim.buy_pack(what)
+
+
+## People out tonight: fans, locals, pros from other clubs, sometimes a teammate.
+## Seeded by venue + slot so the same crowd is there until time moves on.
+static func patrons(w: World, id: String) -> Array:
+	var sim := w.life().sim
+	var counts: Array = data(id).get("patrons", [2, 2, 2, 2])
+	var n := int(counts[clampi(sim.slot, 0, counts.size() - 1)])
+	var rng := RandomNumberGenerator.new()
+	rng.seed = hash("%s/%d" % [id, sim.abs_slot()])
+	var out: Array = []
+	var pros: Array = []
+	for t: TeamData in w.teams:
+		if t == w.user_team():
+			continue
+		for p: PlayerData in t.roster:
+			if not p.is_user:
+				pros.append(p)
+	var mates: Array = []
+	if not w.teamless and w.user_team() != null:
+		for p: PlayerData in w.user_team().roster:
+			if not p.is_user:
+				mates.append(p)
+	var pro_chance := 0.18 if id in ["bar", "club", "arena"] else 0.08
+	if id == "bar" and sim.team_out_tonight():
+		# Celebrating a win: your teammates are all here.
+		for m: PlayerData in mates:
+			out.append({"kind": "mate", "p": m, "name": m.player_name})
+	for i in n:
+		var roll := rng.randf()
+		if roll < 0.08 and not mates.is_empty() and id != "shop":
+			var m: PlayerData = mates[rng.randi() % mates.size()]
+			if not out.any(func(o: Dictionary) -> bool: return o.get("p") == m):
+				out.append({"kind": "mate", "p": m, "name": m.player_name})
+				continue
+		if roll < 0.08 + pro_chance and not pros.is_empty():
+			var q: PlayerData = pros[rng.randi() % pros.size()]
+			if not out.any(func(o: Dictionary) -> bool: return o.get("p") == q):
+				out.append({"kind": "pro", "p": q, "name": q.player_name})
+				continue
+		var fan := rng.randf() < clampf(0.25 + float(w.fame) / 400000.0, 0.25, 0.7)
+		out.append({"kind": "fan" if fan else "local", "p": null, "name": PATRON_FIRST[rng.randi() % PATRON_FIRST.size()], "seed": rng.randi()})
+	return out
+
+
+## Talking to someone. what: chat / photo / drink / trash / hang.
+static func talk(w: World, who: Dictionary, what: String) -> String:
+	var sim := w.life().sim
+	var me := w.user_player
+	var p: PlayerData = who.get("p")
+	var nm := String(who.name)
+	var key := "talk_%s_%s" % [nm, what]
+	var first := not sim.done_today(key)
+	sim.mark_today(key)
+	match what:
+		"photo":
+			if not first:
+				return "%s already has their photo." % nm
+			var f := int(20 + w.fame * 0.0008)
+			w._gain_fame(f)
+			sim.add_need("social", 4.0)
+			return "%s: \"Thank you so much!\" (+%s followers)" % [nm, World.fame_text(f)]
+		"chat":
+			sim.add_need("social", 6.0 if first else 1.0)
+			if String(who.kind) == "fan":
+				return "%s: \"%s\"" % [nm, FAN_LINES[absi(int(who.get("seed", 0))) % FAN_LINES.size()]]
+			if p != null:
+				if first:
+					w._relate(p.uid, 3.0)
+				var v := ChatText.voice(p)
+				var ln: Array = ChatText.line(ChatText.DM.greeting.warm if w.relation(p.uid) > -10.0 else ChatText.DM.greeting.cold, v, w.soc()._slots(p), w.rng)
+				return "%s: \"%s\"" % [nm, String(ln[0])]
+			return "%s: \"%s\"" % [nm, LOCAL_LINES[absi(int(who.get("seed", 0))) % LOCAL_LINES.size()]]
+		"drink":
+			if w.wallet < 14:
+				return "You can't afford a round."
+			w.wallet -= 14
+			sim.add_need("social", 8.0)
+			if p != null and first:
+				w._relate(p.uid, 6.0)
+			return "You buy %s a drink. %s" % [nm, "They appreciate it." if p != null else "They raise it to you."]
+		"flirt":
+			return sim.flirt(nm)
+		"hang":
+			if p == null:
+				return ""
+			sim.add_need("social", 12.0)
+			sim.add_need("fun", 6.0)
+			if first:
+				w._relate(p.uid, 4.0)
+			sim.spend(1)
+			return "You hang out with %s for a while (relationship +4)." % nm
+		"trash":
+			if p == null:
+				return ""
+			w._relate(p.uid, -10.0)
+			var v2 := ChatText.voice(p)
+			var ln2: Array = ChatText.line(ChatText.DM.flame.angry, v2, w.soc()._slots(p), w.rng)
+			var back := ChatText.raw(String(ln2[0]))
+			var t := "%s: \"%s\"" % [nm, back]
+			if sim.drunk >= 50.0 and w.rng.randf() < 0.35:
+				t += " " + fight(w, p)
+			else:
+				w.soc().talk.note_trash_dm(p, 0.6)
+			return t
+	return ""
+
+
+## A bar fight: injury chance, police, the internet.
+static func fight(w: World, p: PlayerData) -> String:
+	var me := w.user_player
+	var sim := w.life().sim
+	w._relate(p.uid, -30.0)
+	var fine := mini(w.wallet, 2500)
+	w.wallet -= fine
+	w._trust(-10.0)
+	sim._scandal("a bar fight with %s" % p.player_name, 1.0)
+	w._post(World.OUTLET_HANDLES.pick_random(), "CHAOS: %s and %s thrown out of a bar after a fight. Police were called." % [me.player_name, p.player_name], "press", 2.3)
+	var t := "It turns into a fight. Bouncers throw you both out; the police fine you $%s." % World._fmt(fine)
+	if w.rng.randf() < 0.3 and me.out_weeks == 0:
+		me.out_weeks = 1
+		me.ailment = "a hand injury"
+		t += " Your hand is swollen: out for a week."
+	sim.location = "city"
+	return t
