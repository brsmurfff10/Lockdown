+class_name LifeHud
+extends RefCounted
+## Small shared widgets for My Player life: need bars and status tags
+## (home, venues, city).
+
+
+## Fill `row` with four labelled bars (energy, food, fun, social).
+static func needs_row(row: HBoxContainer, sim: LifeSim) -> void:
+	for c in row.get_children():
+		c.queue_free()
+	for k: String in LifeSim.NEEDS:
+		var v := sim.need(k)
+		var box := UI.vbox(1)
+		box.add_child(UI.label(String(LifeSim.NEED_NAMES[k]), 10, UI.TEXT_FAINT, 600))
+		var bar := ProgressBar.new()
+		bar.min_value = 0.0
+		bar.max_value = 100.0
+		bar.value = v
+		bar.show_percentage = false
+		bar.custom_minimum_size = Vector2(76, 7)
+		var col := UI.GOOD if v >= 55.0 else (UI.WARN if v >= 25.0 else UI.BAD)
+		var fill := StyleBoxFlat.new()
+		fill.bg_color = col
+		fill.set_corner_radius_all(3)
+		var bg := StyleBoxFlat.new()
+		bg.bg_color = Color(1, 1, 1, 0.08)
+		bg.set_corner_radius_all(3)
+		bar.add_theme_stylebox_override("fill", fill)
+		bar.add_theme_stylebox_override("background", bg)
+		box.add_child(bar)
+		row.add_child(box)
+
+
+## Status pills: drunk, hungover, high, cravings, fresh...
+static func tags(flow: HFlowContainer, sim: LifeSim) -> void:
+	for c in flow.get_children():
+		c.queue_free()
+	for t: Array in sim.status_tags():
+		var col: Color = [UI.GOOD, UI.WARN, UI.BAD][clampi(int(t[1]), 0, 2)]
+		flow.add_child(UI.pill(String(t[0]), col, 11))
