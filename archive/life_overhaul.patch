+			_dealer_panel()
+		"trainer":
+			_trainer_panel()
+		"coach":
+			_coach_talk()
+		"clerk":
+			if venue == "diner":
+				var r := Venues.act(w, "eat")
+				_say(String(r.text))
+			else:
+				_shop_panel()
+		"dj":
+			var r2 := Venues.act(w, "dj")
+			_say(String(r2.text))
+		"patron":
+			_talk_panel(n)
+
+
+func _drink_panel() -> void:
+	var box := _open(520, "Bar")
+	box.add_child(UI.label("%s  -  %s" % [sim.drunk_text(), "wallet %s" % UI.money_text(w.wallet)], 13, UI.TEXT_DIM))
+	for id: String in ["beer", "wine", "cocktail", "shots"]:
+		var it: Dictionary = LifeSim.ITEMS[id]
+		var idd := id
+		_row(box, String(it.name), "$%d  -  drunk +%d" % [int(it.cost), int(it.drunk)], "Order", func() -> void:
+			var r := Venues.drink(w, idd)
+			_drink_panel()
+			_say(String(r.text)))
+	_row(box, "Water", "$1  -  helps tomorrow", "Order", func() -> void:
+		if w.wallet >= 1:
+			w.wallet -= 1
+			sim.hangover = maxf(0.0, sim.hangover - 6.0)
+			sim.drunk_peak = maxf(sim.drunk, sim.drunk_peak - 4.0)
+		_drink_panel()
+		_say("A glass of water. Future you says thanks."))
+
+
+func _shop_panel() -> void:
+	var box := _open(520, "Corner shop")
+	box.add_child(UI.label("Wallet %s    Stash: %s" % [UI.money_text(w.wallet), sim.stash_text()], 12, UI.TEXT_DIM))
+	for id: String in LifeSim.STASH_PACKS:
+		var pk: Dictionary = LifeSim.STASH_PACKS[id]
+		var idd := id
+		_row(box, String(pk.name), "$%d  -  %d into your stash (use from your phone)" % [int(pk.cost), int(pk.n)], "Buy", func() -> void:
+			var r := Venues.shop_buy(w, idd)
+			_shop_panel()
+			_say(r if r != "" else "Bought."))
+	for x: Array in [["snack", "Snacks", "$6  -  food +25"], ["energy", "Energy drink", "$5  -  energy +15"], ["water", "Water", "$2  -  hangover down"]]:
+		var k := String(x[0])
+		_row(box, String(x[1]), String(x[2]), "Buy", func() -> void:
+			var r2 := Venues.shop_buy(w, k)
+			_shop_panel()
+			_say(r2 if r2 != "" else "Done."))
+
+
+func _smoke_panel() -> void:
+	var box := _open(480, "Smoking area")
+	box.add_child(UI.label("Stash: %s" % sim.stash_text(), 12, UI.TEXT_DIM))
+	_row(box, "Cigarette", "From your stash, or bum one for $2.", "Smoke", func() -> void:
+		var r := sim.consume("cig", sim.stash.has("cig"))
+		_close()
+		_say(String(r.text)))
+	if sim.stash.has("joint"):
+		_row(box, "Joint", "From your stash.", "Smoke", func() -> void:
+			var r2 := sim.consume("joint", true)
+			_close()
+			_say(String(r2.text)))
+
+
+func _dealer_panel() -> void:
+	var box := _open(540, "Guy in a hoodie")
+	box.add_child(UI.label("\"You looking for something?\"", 14, UI.TEXT, 600))
+	box.add_child(UI.label("Banned substances show up in match-day drug tests for a few days.", 11, UI.WARN))
+	for id: String in ["joint", "vex", "blitz"]:
+		var it: Dictionary = LifeSim.ITEMS[id]
+		var idd := id
+		_row(box, "%s  ($%d)" % [String(it.name), int(it.cost)], String(it.get("desc", "")), "Buy", func() -> void:
+			var r := sim.buy_drug(idd)
+			_dealer_panel()
+			_say(r if r != "" else "He slips it into your hand. It's in your stash (phone)."))
+	if not sim.stash.is_empty():
+		box.add_child(UI.divider())
+		box.add_child(UI.label("Use something from your stash here", 13, UI.TEXT, 600))
+		_stash_buttons(box)
+
+
+func _stash_buttons(box: VBoxContainer) -> void:
+	var flow := HFlowContainer.new()
+	flow.add_theme_constant_override("h_separation", 6)
+	flow.add_theme_constant_override("v_separation", 6)
+	for id: String in sim.stash:
+		var idd := id
+		flow.add_child(UI.small_button("%s (%d)" % [String(LifeSim.ITEMS[id].name), int(sim.stash[id])], func() -> void:
+			var r := sim.consume(idd, true)
+			_close()
+			_say(String(r.text)), 0, "GhostButton"))
+	box.add_child(flow)
+
+
+func _trainer_panel() -> void:
+	var box := _open(480, "Coach Dana")
+	box.add_child(UI.label("\"One hour, one-on-one. You'll hate me, then you'll thank me.\"", 13, UI.TEXT_DIM))
+	_row(box, "Personal session ($150)", "Movement training, more than a normal workout. Once a day.", "Train", func() -> void:
+		if sim.done_today("pt"):
+			_close()
+			_say("Dana: \"Rest. Come back tomorrow.\"")
+			return
+		if w.wallet < 150:
+			_close()
+			_say("You can't afford it.")
+			return
+		w.wallet -= 150
+		sim.mark_today("pt")
+		var d := Progression.train(w.user_player, "movement", w.rng, 0.35, 0.15)
+		sim.add_need("energy", -18.0)
+		sim.spend(1)
+		_close()
+		_say("Brutal session. Movement %+.2f." % d), sim.done_today("pt"))
+
+
+func _coach_talk() -> void:
+	var t := w.coach_trust
+	var line := "Keep doing what you're doing." if t >= 60.0 else ("You're on thin ice." if t < 35.0 else "I need more from you.")
+	if sim.hangover > 30.0:
+		line = "You smell like a brewery. Go drink some water."
+	_say("Coach: \"%s\"" % line, 5.0)
+
+
+func _practice_panel() -> void:
+	var box := _open(560, "Team practice")
+	if w.teamless:
+		box.add_child(UI.label("You don't have a club. Nobody's practising with you here.", 13, UI.WARN))
+		return
+	if w.trained_this_week:
+		box.add_child(UI.label("You've had your team session this week.", 13, UI.TEXT_DIM))
+		return
+	box.add_child(UI.label("Your weekly team session (the same as Training in the career hub). Takes the afternoon.", 12, UI.TEXT_DIM))
+	if sim.hangover > 30.0 or sim.drunk > 25.0:
+		box.add_child(UI.label("You're not in a state to train well. Everyone can tell.", 12, UI.WARN))
+	var flow := HFlowContainer.new()
+	flow.add_theme_constant_override("h_separation", 6)
+	flow.add_theme_constant_override("v_separation", 6)
+	for k: String in PlayerData.STAT_KEYS:
+		var kk := k
+		flow.add_child(UI.small_button(String(PlayerData.STAT_NAMES[k]), func() -> void:
+			var d := w.train_user(kk, "Normal")
+			if sim.hangover > 30.0 or sim.drunk > 25.0:
+				w.user_player.set_stat(kk, w.user_player.stat(kk) - absf(d) * 0.5)
+				w._trust(-3.0)
+			sim.spend(1)
+			sim.add_need("energy", -10.0)
+			_close()
+			_say("Team practice: %s %+.1f." % [PlayerData.STAT_NAMES[kk], d]), 0, "GhostButton"))
+	box.add_child(flow)
+
+
+func _stage() -> void:
+	if sim.is_match_time():
+		_play_match_now()
+		return
+	_say("The stage is empty. %s." % sim.match_text())
+
+
+func _talk_panel(n: Dictionary) -> void:
+	var who: Dictionary = n.who
+	var kind := String(who.kind)
+	var box := _open(480, String(n.name))
+	var sub := {"fan": "A fan.", "local": "A regular.", "mate": "Your teammate.", "pro": "A pro from %s." % _team_short(who.get("p"))}.get(kind, "") as String
+	box.add_child(UI.label(sub, 12, UI.TEXT_DIM))
+	var opts: Array = [["chat", "Chat"]]
+	if kind == "fan":
+		opts.append(["photo", "Take a photo with them"])
+	if kind in ["pro", "local", "fan", "mate"]:
+		opts.append(["drink", "Buy them a drink ($14)"])
+	if kind in ["mate", "pro"]:
+		opts.append(["hang", "Hang out (takes a while)"])
+	if kind == "pro":
+		opts.append(["trash", "Talk shit"])
+	if kind in ["local", "fan"] and venue in ["bar", "club"]:
+		opts.append(["flirt", "Flirt"])
+	for o: Array in opts:
+		var what := String(o[0])
+		box.add_child(UI.button(String(o[1]), func() -> void: _talk_do(who, what), 0, "GhostButton" if what != "trash" else "DangerButton"))
+
+
+func _talk_do(who: Dictionary, what: String) -> void:
+	var r := Venues.talk(w, who, what)
+	_close()
+	_say(r, 5.0)
+	if sim.location == "city":
+		Game.pending_toast = r # Thrown out after a fight.
+		_leave()
+
+
+func _stash_panel() -> void:
+	var box := _open(480, "Stash")
+	if sim.stash.is_empty():
+		box.add_child(UI.label("Nothing. The corner shop sells beer and cigarettes.", 13, UI.TEXT_DIM))
+		return
+	box.add_child(UI.label("Use something now.", 12, UI.TEXT_DIM))
+	_stash_buttons(box)
+
+
+## A taxi: straight to a place (no car needed, no drink driving).
+func _taxi_panel() -> void:
+	var box := _open(560, "Taxi")
+	box.add_child(UI.label("Straight to the door. It's %s." % sim.time_text(), 12, UI.TEXT_DIM))
+	for id: String in Venues.IDS:
+		var idd := id
+		var open := Venues.is_open(id, sim.slot)
+		var fare := 25 if id != "arena" else 40
+		_row(box, Venues.name_of(id), Venues.hours_text(id) + ("" if open else "  (closed now)"), "$%d" % fare, func() -> void:
+			if w.wallet < fare:
+				_close()
+				_say("You can't afford the fare.")
+				return
+			w.wallet -= fare
+			Game.venue = idd
+			Game.home_tour = ""
+			sim.location = idd
+			Game.save_player_career_soon()
+			Game.goto(Game.HOME_SCENE), not open)
+	if venue != "":
+		_row(box, "Home", "Back to your place.", "$25", func() -> void:
+			if w.wallet < 25:
+				_close()
+				_say("You can't afford the fare.")
+				return
+			w.wallet -= 25
+			if venue in ["bar", "club"] and sim.slot >= 2:
+				var seen := sim.night_out_done(String(data.get("name", venue)))
+				if seen != "":
+					Game.pending_toast = seen
+			Game.venue = ""
+			sim.location = "home"
+			Game.save_player_career_soon()
+			Game.goto(Game.HOME_SCENE))
+
+
+func _rehab() -> void:
+	var rr := sim.rehab()
+	_close()
+	_say(rr, 6.0)
+	_spawn_life()
