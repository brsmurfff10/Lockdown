+++ b/art/venues/venues.py
@@ -0,0 +1,229 @@
+"""Venue interiors for My Player's city (bar, club, gym, diner, corner shop,
+training ground, arena). Writes data/venues/<id>.json in the same format as
+data/homes (grid + items from data/homes/props.json), plus venue extras:
+name, open slots, npcs and patrons. Run: python art/venues/venues.py
+
+Grid chars: # wall, W window, E exit, D inner door, floors: . wood, , tile,
+~ carpet, _ concrete, m marble, s stone, g grass, f dance floor, k club floor,
+r gym rubber. Items with k "zone_*" are invisible use areas (not solid).
+"""
+import json
+import os
+
+ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+PROPS = json.load(open(os.path.join(ROOT, "data", "homes", "props.json")))["props"]
+
+
+WALLS = {"bar": "5a3a2c", "club": "2b2238", "gym": "4a4f57", "diner": "c9b79c", "shop": "b8bcc2", "training": "3c4250", "arena": "2f3340"}
+
+
+class Room:
+    def __init__(self, w, h, floor):
+        self.w, self.h = w, h
+        self.g = [["#"] * w for _ in range(h)]
+        self.fill(1, 1, w - 2, h - 2, floor)
+        self.items = []
+        self.npcs = []
+
+    def fill(self, x, y, w, h, ch):
+        for yy in range(y, y + h):
+            for xx in range(x, x + w):
+                self.g[yy][xx] = ch
+
+    def wall_h(self, x, y, w, door=None):
+        for xx in range(x, x + w):
+            self.g[y][xx] = "#"
+        if door is not None:
+            self.g[y][door] = "D"
+
+    def wall_v(self, x, y, h, door=None):
+        for yy in range(y, y + h):
+            self.g[yy][x] = "#"
+        if door is not None:
+            self.g[door][x] = "D"
+
+    def windows(self, xs):
+        for x in xs:
+            self.g[0][x] = "W"
+
+    def exit(self, x):
+        self.g[self.h - 1][x] = "E"
+        self.spawn = [x, self.h - 2]
+
+    def add(self, k, x, y, rot=0, use=""):
+        d = {"k": k, "x": x, "y": y, "rot": rot}
+        if use:
+            d["use"] = use
+        if not k.startswith("zone_"):
+            pr = PROPS[k]
+            pw, ph = (pr["h"], pr["w"]) if rot in (90, 270) else (pr["w"], pr["h"])
+            for yy in range(y, y + ph):
+                for xx in range(x, x + pw):
+                    assert 0 < xx < self.w - 1 and 0 < yy < self.h - 1, (k, x, y)
+                    assert self.g[yy][xx] not in "#WED", (k, x, y, self.g[yy][xx])
+        self.items.append(d)
+
+    def zone(self, name, x, y, w, h, use):
+        self.items.append({"k": "zone_" + name, "x": x, "y": y, "w": w, "h": h, "rot": 0, "use": use})
+
+    def npc(self, role, x, y, name=""):
+        assert self.g[y][x] not in "#WED"
+        self.npcs.append({"role": role, "x": x, "y": y, "name": name})
+
+    def out(self, vid, name, open_slots, patrons, extra=None):
+        d = {"name": name, "wall": WALLS.get(vid, "cfcac0"), "open": open_slots, "patrons": patrons, "grid": ["".join(r) for r in self.g],
+             "spawn": self.spawn, "items": self.items, "npcs": self.npcs}
+        if extra:
+            d.update(extra)
+        p = os.path.join(ROOT, "data", "venues", vid + ".json")
+        os.makedirs(os.path.dirname(p), exist_ok=True)
+        json.dump(d, open(p, "w"), indent=1)
+        print("wrote", p, "%dx%d" % (self.w, self.h))
+
+
+def bar():
+    r = Room(22, 15, ".")
+    r.windows([3, 4, 5, 9, 10, 11, 16, 17])
+    # Smoking terrace on the right, through a door.
+    r.wall_v(16, 1, 13, door=11)
+    r.fill(17, 1, 4, 13, "s")
+    r.add("bar_counter", 2, 3, 0, "drink")
+    r.add("bar_counter", 6, 3, 0, "drink")
+    r.npc("bartender", 5, 2, "Bartender")
+    r.add("tv_big", 2, 1, 0, "watch")
+    r.add("sofa", 1, 6, 90, "hangout")
+    r.add("coffee_table", 3, 7, 90)
+    r.add("dining_table", 9, 6, 0, "hangout")
+    r.add("dining_table", 9, 10, 0, "hangout")
+    r.add("armchair", 4, 10, 0, "hangout")
+    r.add("arcade", 14, 1, 0, "arcade")
+    r.add("arcade", 15, 1, 0, "arcade")
+    r.add("toilet", 14, 6, 0, "toilet")
+    r.add("plant", 1, 12, 0)
+    r.add("plant", 14, 12, 0)
+    r.add("lamp", 12, 1, 0)
+    r.add("patio_set", 17, 2, 0, "smoke")
+    r.zone("smoke", 17, 6, 4, 6, "smoke")
+    r.add("plant_big", 20, 12, 0)
+    r.exit(8)
+    r.out("bar", "The Neon Tap", [1, 2, 3], [3, 6, 9, 7], {"kind": "bar"})
+
+
+def club():
+    r = Room(26, 18, "k")
+    # Dance floor in the middle.
+    r.fill(8, 6, 10, 7, "f")
+    r.zone("dance", 8, 6, 10, 7, "dance")
+    r.add("bar_counter", 2, 2, 0, "drink")
+    r.add("bar_counter", 6, 2, 0, "drink")
+    r.npc("bartender", 5, 1, "Bartender")
+    r.add("desk_pc_3", 11, 2, 0, "dj")
+    r.npc("dj", 12, 1, "DJ Voltage")
+    # VIP area (top right) behind a door.
+    r.wall_h(18, 6, 7, door=21)
+    r.wall_v(18, 1, 5)
+    r.fill(19, 1, 6, 5, "~")
+    r.add("sofa_corner", 19, 1, 0, "vip")
+    r.add("coffee_table", 22, 4, 0)
+    # Toilets (bottom right) and the back corridor where the dealer hangs out.
+    r.wall_h(19, 12, 6, door=20)
+    r.wall_v(19, 12, 5)
+    r.fill(20, 13, 5, 4, ",")
+    r.add("toilet", 23, 13, 0, "toilet")
+    r.add("sink", 23, 15, 0, "toilet")
+    r.npc("dealer", 21, 15, "Guy in a hoodie")
+    r.add("sofa", 1, 8, 90, "hangout")
+    r.add("sofa", 1, 13, 90, "hangout")
+    r.add("lamp", 1, 6, 0)
+    r.add("plant_big", 16, 16, 0)
+    r.exit(10)
+    r.out("club", "Pulse", [2, 3], [0, 0, 10, 16], {"kind": "club"})
+
+
+def gym():
+    r = Room(20, 14, "r")
+    r.windows([3, 4, 5, 13, 14, 15])
+    r.add("home_gym", 1, 1, 0, "workout")
+    r.add("home_gym", 6, 1, 0, "workout")
+    r.add("home_gym", 1, 5, 0, "workout")
+    r.add("home_gym", 6, 5, 0, "workout")
+    r.npc("trainer", 11, 4, "Coach Dana")
+    # Changing rooms + sauna on the right.
+    r.wall_v(13, 1, 12, door=10)
+    r.fill(14, 1, 5, 12, ",")
+    r.add("hot_tub", 15, 1, 0, "sauna")
+    r.add("shower", 14, 6, 0, "shower")
+    r.add("shower", 16, 6, 0, "shower")
+    r.add("wardrobe", 15, 11, 0)
+    r.add("plant", 11, 12, 0)
+    r.add("bookshelf", 1, 12, 0)
+    r.exit(6)
+    r.out("gym", "Iron Works Gym", [0, 1, 2], [3, 4, 3, 0], {"kind": "gym"})
+
+
+def diner():
+    r = Room(18, 12, ",")
+    r.windows([2, 3, 4, 7, 8, 9, 12, 13, 14])
+    r.add("kitchen_line", 1, 1, 0)
+    r.add("bar_counter", 2, 3, 0, "coffee")
+    r.npc("clerk", 3, 2, "Server")
+    r.add("dining_table", 8, 2, 0, "eat")
+    r.add("dining_table", 13, 2, 0, "eat")
+    r.add("dining_table", 8, 7, 0, "eat")
+    r.add("dining_table", 13, 7, 0, "eat")
+    r.add("plant", 1, 10, 0)
+    r.add("fridge", 6, 1, 0)
+    r.exit(4)
+    r.out("diner", "Corner Diner", [0, 1, 2, 3], [2, 4, 4, 2], {"kind": "diner"})
+
+
+def shop():
+    r = Room(14, 10, ",")
+    r.windows([2, 3, 4, 9, 10, 11])
+    r.add("bar_counter", 1, 6, 0, "shop")
+    r.npc("clerk", 2, 5, "Clerk")
+    r.add("fridge", 10, 1, 0, "shop")
+    r.add("fridge", 11, 1, 0, "shop")
+    r.add("fridge", 12, 1, 0, "shop")
+    r.add("bookshelf", 1, 1, 0)
+    r.add("bookshelf", 5, 1, 0)
+    r.add("bookshelf", 6, 4, 0)
+    r.exit(9)
+    r.out("shop", "24/7 Corner Shop", [0, 1, 2, 3], [1, 1, 1, 1], {"kind": "shop"})
+
+
+def training():
+    r = Room(22, 14, "_")
+    r.windows([3, 4, 5, 15, 16, 17])
+    for i in range(5):
+        r.add("desk_pc_2", 1 + i * 4, 1, 0, "practice")
+    r.add("tv_big", 1, 6, 0, "review")
+    r.add("sofa", 2, 8, 0, "review")
+    r.add("home_gym", 14, 7, 0, "workout")
+    r.npc("coach", 9, 5, "Coach")
+    r.add("trophy_cabinet", 18, 12, 0)
+    r.add("plant_big", 20, 1, 0)
+    r.add("kitchenette", 9, 12, 0, "eat_free")
+    r.exit(6)
+    r.out("training", "Team training ground", [0, 1, 2], [2, 3, 2, 0], {"kind": "training"})
+
+
+def arena():
+    r = Room(26, 16, "m")
+    # Stage with five PCs a side.
+    r.fill(3, 1, 20, 5, "_")
+    for i in range(5):
+        r.add("desk_pc_3", 3 + i * 4, 1, 0, "stage")
+    r.add("tv_big", 10, 6, 0)
+    r.add("sofa_corner", 1, 9, 0, "hangout")
+    r.add("bar_counter", 18, 10, 0, "eat_free")
+    r.add("trophy_cabinet", 9, 14, 0)
+    r.add("plant_big", 24, 14, 0)
+    r.add("plant_big", 1, 14, 0)
+    r.exit(14)
+    r.out("arena", "Lockdown Arena", [0, 1, 2, 3], [4, 6, 12, 4], {"kind": "arena"})
+
+
+if __name__ == "__main__":
+    for f in (bar, club, gym, diner, shop, training, arena):
+        f()
