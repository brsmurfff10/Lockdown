diff --git a/scripts/career/life_sim.gd b/scripts/career/life_sim.gd
new file mode 100644
index 0000000..8f0dae5
--- /dev/null
+++ b/scripts/career/life_sim.gd
@@ -0,0 +1,953 @@
+class_name LifeSim
+extends RefCounted
+## My Player daily life: a week is 7 days of 4 slots (morning, afternoon,
+## evening, night). Doing things uses slots; sleeping starts the next day and
+## sleeping through Sunday night ends the week (World.advance_week). Your match
+## is on Saturday evening. Needs (energy, hunger, fun, social), drinking,
+## smoking and drugs (fictional names), hangovers, dependence, drug tests and
+## the trouble you can get into. match_mods() is what your night out does to
+## your next match. Saved inside Lifestyle ("life" -> "sim").
+
+const DAYS := ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]
+const DAY_SHORT := ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
+const SLOTS := ["Morning", "Afternoon", "Evening", "Night"]
+const MATCH_DAY := 5
+const MATCH_SLOT := 2
+const NEEDS := ["energy", "hunger", "fun", "social"]
+const NEED_NAMES := {"energy": "Energy", "hunger": "Food", "fun": "Fun", "social": "Social"}
+
+## Things you can drink, smoke or take. kind groups dependence and effects.
+## drunk: added per drink. slots: how long it lasts. trace: days a drug test can find it.
+const ITEMS := {
+	"beer": {"name": "Beer", "kind": "alcohol", "drunk": 11.0, "cost": 8, "fun": 4.0, "social": 2.0},
+	"wine": {"name": "Glass of wine", "kind": "alcohol", "drunk": 13.0, "cost": 14, "fun": 4.0, "social": 2.0},
+	"cocktail": {"name": "Cocktail", "kind": "alcohol", "drunk": 16.0, "cost": 18, "fun": 6.0, "social": 3.0},
+	"shots": {"name": "Round of shots", "kind": "alcohol", "drunk": 24.0, "cost": 25, "fun": 9.0, "social": 5.0},
+	"cig": {"name": "Cigarette", "kind": "nicotine", "cost": 2, "fun": 3.0, "desc": "Takes the edge off. Hard to stop."},
+	"joint": {"name": "Joint", "kind": "weed", "slots": 3, "cost": 25, "fun": 14.0, "trace": 5, "desc": "Very relaxed, a bit slow. Hungry."},
+	"vex": {"name": "Vex", "kind": "stim", "slots": 3, "cost": 120, "fun": 6.0, "trace": 4, "desc": "A stimulant: sharp and wired for a few hours, then a crash. Banned."},
+	"blitz": {"name": "Blitz", "kind": "party", "slots": 3, "cost": 90, "fun": 30.0, "social": 15.0, "trace": 3, "desc": "A party pill: the best night ever, a brutal next day. Banned."},
+}
+const KIND_NAMES := {"alcohol": "alcohol", "nicotine": "nicotine", "weed": "weed", "stim": "Vex", "party": "Blitz"}
+const BANNED := ["stim", "party"]
+## Shop items you keep in your stash (bought at the corner shop or from a dealer).
+const STASH_PACKS := {
+	"beer": {"name": "Six-pack", "n": 6, "cost": 30},
+	"cig": {"name": "Pack of cigarettes", "n": 20, "cost": 18},
+	"wine": {"name": "Bottle of wine", "n": 4, "cost": 35},
+}
+
+var _wref: WeakRef
+var w: World:
+	get:
+		return _wref.get_ref() as World if _wref != null else null
+
+var day := 0
+var slot := 0
+var week_stamp := -1 ## World stamp this day/slot belongs to (a week passing elsewhere resets the clock).
+var energy := 85.0
+var hunger := 75.0 ## Fullness: 100 = stuffed, 0 = starving.
+var fun := 65.0
+var social := 60.0
+var drunk := 0.0 ## 0 sober .. 100 blackout.
+var drunk_peak := 0.0 ## Highest tonight (makes tomorrow's hangover).
+var hangover := 0.0 ## 0..100, wears off through the day.
+var active := {} ## kind -> slots left (weed / stim / party).
+var crash := {} ## kind -> slots left of the come-down.
+var dep := {} ## kind -> dependence 0..100.
+var last_use := {} ## kind -> abs slot.
+var trace := {} ## kind -> days a test still finds it.
+var stash := {} ## item id -> count.
+var used := {} ## action -> abs day it was last done (once a day).
+var licence_until := 0 ## Abs week your licence comes back (drink driving).
+var tested := -1 ## World stamp of the last match-day drug test.
+var log: Array = [] ## Recent things that happened (newest last).
+var location := "home" ## home / city / a venue id.
+var car_at := "home" ## City place your car is parked at.
+var drove_in := false ## Came to the venue by car (it's parked outside).
+var nights_out := 0 ## Nights out this week (the coach notices a pattern).
+var week_drinks := 0
+var no_shows := 0
+var bans := 0 ## Failed drug tests.
+var team_night := -1 ## Abs day the team is out at the bar after a win (you're invited).
+var crush := "" ## Someone whose number you got.
+var partner := "" ## Who you're seeing.
+var love := 0.0 ## How it's going (0..100). Neglect it and it ends.
+var last_date := -100 ## Abs day of your last date.
+var dates := 0
+
+
+func _init(world: World) -> void:
+	_wref = weakref(world)
+
+
+# --- Clock ---------------------------------------------------------------------
+
+func sync() -> void:
+	if w == null:
+		return
+	if week_stamp != w.stamp():
+		week_stamp = w.stamp()
+		day = 0
+		slot = 0
+		nights_out = 0
+		week_drinks = 0
+
+
+func abs_week() -> int:
+	return w.season * World.SEASON_WEEKS + w.week
+
+
+func abs_day() -> int:
+	sync()
+	return abs_week() * 7 + day
+
+
+func abs_slot() -> int:
+	return abs_day() * 4 + slot
+
+
+func time_text() -> String:
+	sync()
+	return "%s %s" % [DAYS[day], SLOTS[slot].to_lower()]
+
+
+func short_time() -> String:
+	sync()
+	return "%s %s" % [DAY_SHORT[day], SLOTS[slot]]
+
+
+func has_match() -> bool:
+	return w != null and w.mode == "player" and not w.user_match_this_week().is_empty() and not w.retired
+
+
+func is_match_time() -> bool:
+	sync()
+	return has_match() and day == MATCH_DAY and slot == MATCH_SLOT
+
+
+func before_match() -> bool:
+	sync()
+	return has_match() and (day < MATCH_DAY or (day == MATCH_DAY and slot < MATCH_SLOT))
+
+
+func is_night() -> bool:
+	sync()
+	return slot >= 2
+
+
+func match_text() -> String:
+	if not has_match():
+		return "No match this week"
+	if is_match_time():
+		return "Your match is NOW"
+	if before_match():
+		var d := MATCH_DAY - day
+		if d == 0:
+			return "Match tonight"
+		return "Match on Saturday evening (%s)" % ("tomorrow" if d == 1 else "in %d days" % d)
+	return "Match missed"
+
+
+## Pass n slots awake. Staying up past night rolls into the next morning
+## without sleep.
+func spend(n: int) -> void:
+	sync()
+	for i in n:
+		_tick_slot()
+		slot += 1
+		if slot > 3:
+			slot = 0
+			_new_day(false)
+
+
+## Go to bed: wake up the next morning. comfort: your bed (Lifestyle.comfort()).
+func sleep(comfort: int = 8) -> String:
+	sync()
+	var early := slot <= 2
+	var gain := 40.0 + comfort * 2.5 + (12.0 if early else 0.0)
+	if active.has("stim"):
+		gain *= 0.5 # Wired: you barely sleep.
+	energy = minf(100.0, energy + gain)
+	var parts: Array = []
+	var was_drunk := drunk_peak
+	slot = 0
+	_new_day(true)
+	parts.append("You wake up on %s." % DAYS[day])
+	if hangover > 0.0:
+		parts.append(_hangover_text(was_drunk))
+	if crash.has("party"):
+		parts.append("The Blitz comedown hits hard: everything feels grey.")
+	return " ".join(parts)
+
+
+func nap() -> String:
+	sync()
+	if slot >= 3:
+		return sleep(8)
+	energy = minf(100.0, energy + 18.0)
+	hangover = maxf(0.0, hangover - 15.0)
+	spend(1)
+	return "You nap for a few hours. Energy +18."
+
+
+func _tick_slot() -> void:
+	energy -= 7.0
+	hunger -= 8.0 + (6.0 if active.has("weed") else 0.0)
+	fun -= 4.0
+	social -= 3.0
+	if active.has("stim"):
+		energy += 9.0
+		hunger += 4.0
+	if crash.has("stim"):
+		energy -= 6.0
+	drunk = maxf(0.0, drunk - 10.0)
+	hangover = maxf(0.0, hangover - 14.0)
+	for k: String in active.keys():
+		active[k] = int(active[k]) - 1
+		if int(active[k]) <= 0:
+			active.erase(k)
+			if k == "stim":
+				crash["stim"] = 3
+	for k: String in crash.keys():
+		crash[k] = int(crash[k]) - 1
+		if int(crash[k]) <= 0:
+			crash.erase(k)
+	for k: String in cravings():
+		fun -= float(dep[k]) / 14.0
+	_clamp()
+
+
+func _clamp() -> void:
+	energy = clampf(energy, 0.0, 100.0)
+	hunger = clampf(hunger, 0.0, 100.0)
+	fun = clampf(fun, 0.0, 100.0)
+	social = clampf(social, 0.0, 100.0)
+	drunk = clampf(drunk, 0.0, 100.0)
+	hangover = clampf(hangover, 0.0, 100.0)
+
+
+func _new_day(slept: bool) -> void:
+	var p := w.user_player
+	if drunk_peak > 30.0:
+		hangover = clampf((drunk_peak - 25.0) * 1.3, 0.0, 100.0) * (1.0 if slept else 0.7)
+	if active.has("party"):
+		active.erase("party")
+	if last_use.has("party") and abs_slot() - int(last_use.party) < 8:
+		crash["party"] = 4
+	if slept:
+		drunk = 0.0
+	else:
+		energy -= 25.0
+		drunk *= 0.5
+		_note("You stayed up all night.")
+	drunk_peak = drunk
+	for k: String in dep.keys():
+		dep[k] = maxf(0.0, float(dep[k]) - (1.5 if k == "nicotine" else 2.5))
+		if float(dep[k]) <= 0.0:
+			dep.erase(k)
+	for k: String in trace.keys():
+		trace[k] = int(trace[k]) - 1
+		if int(trace[k]) <= 0:
+			trace.erase(k)
+	# Mood: how well you've been looking after yourself.
+	if p != null:
+		var mood := (energy + hunger + fun + social) / 4.0
+		p.morale = clampf(p.morale + clampf((mood - 50.0) / 20.0, -2.0, 1.5), 0.0, 100.0)
+	_coach_notices()
+	_love_day()
+	_clamp()
+	day += 1
+	if day > 6:
+		_end_week()
+
+
+## Sunday night is over: the week happens (your match if you never turned up).
+func _end_week() -> void:
+	day = 6
+	slot = 3
+	if has_match():
+		no_shows += 1
+		w.sim_user_match()
+		w._trust(-15.0)
+		w.forced_bench_until = maxi(w.forced_bench_until, w.stamp() + 2)
+		w._news("NO-SHOW: you never turned up for your match. The coach benches you.")
+		_note("You missed your match.")
+	var r := w.advance_week()
+	if r != "":
+		# Free agency / retired: the week can't pass yet. Start the week again.
+		week_stamp = w.stamp()
+	else:
+		week_stamp = w.stamp()
+	day = 0
+	slot = 0
+	nights_out = 0
+	week_drinks = 0
+	Game.save_player_career_soon()
+
+
+## Sleep straight through to a day/slot (keeps you fed and rested: routine days).
+func skip_to(target_day: int, target_slot: int) -> void:
+	sync()
+	var guard := 0
+	while (day < target_day or (day == target_day and slot < target_slot)) and guard < 40:
+		guard += 1
+		var wk := week_stamp
+		if slot >= 3 or (slot == 2 and day < target_day):
+			sleep(w.life().comfort())
+			hunger = maxf(hunger, 70.0)
+			fun = maxf(fun, 45.0)
+			social = maxf(social, 40.0)
+		else:
+			spend(1)
+			hunger = maxf(hunger, 55.0)
+		if week_stamp != wk:
+			return
+
+
+func skip_to_match() -> void:
+	skip_to(MATCH_DAY, MATCH_SLOT)
+
+
+## Sleep through the rest of the week (into next Monday morning).
+func skip_week() -> void:
+	sync()
+	var wk := w.stamp()
+	var guard := 0
+	while w.stamp() == wk and guard < 40:
+		guard += 1
+		if is_match_time() or (day == MATCH_DAY and slot == MATCH_SLOT and has_match()):
+			return # Play (or simulate) your match first.
+		if slot >= 2:
+			sleep(w.life().comfort())
+			hunger = maxf(hunger, 70.0)
+			fun = maxf(fun, 45.0)
+		else:
+			spend(1)
+		if w.retired or w.free_agency:
+			return
+
+
+## After your match: it's Saturday night.
+func after_match() -> void:
+	sync()
+	if day == MATCH_DAY and slot <= MATCH_SLOT:
+		slot = 3
+	energy = maxf(0.0, energy - 15.0)
+	hunger = maxf(0.0, hunger - 10.0)
+	location = "home"
+	var ut := w.user_team()
+	if ut != null and not w.teamless and ut.streak > 0 and team_night != abs_day():
+		team_night = abs_day()
+		w._news("TEAM: the boys are celebrating at The Neon Tap tonight. You're invited.")
+		Game.pending_toast = "You won! The team is going to The Neon Tap tonight."
+
+
+func team_out_tonight() -> bool:
+	return team_night == abs_day() and slot >= 2
+
+
+# --- Dating ----------------------------------------------------------------------
+
+## Try your luck with someone at a bar or club. Returns what happened.
+func flirt(name: String) -> String:
+	if partner == name:
+		return "%s laughs: \"You know you've already got me, right?\"" % name
+	var key := "flirt_" + name
+	if done_today(key):
+		return "%s has heard enough of your lines for one night." % name
+	mark_today(key)
+	var chance := 0.25 + clampf(float(w.fame) / 600000.0, 0.0, 0.3) + (0.1 if drunk > 10.0 and drunk < 45.0 else 0.0) - (0.25 if drunk >= 60.0 else 0.0)
+	if w.rng.randf() < chance:
+		crush = name
+		social = minf(100.0, social + 10.0)
+		fun = minf(100.0, fun + 8.0)
+		return "%s gives you their number. Ask them out from your phone." % name
+	social = minf(100.0, social + 2.0)
+	if drunk >= 60.0:
+		return "%s: \"You're wasted. Goodnight.\"" % name
+	return "%s smiles politely and goes back to their friends." % name
+
+
+## A date (from your phone): dinner and drinks, takes the evening.
+func date() -> String:
+	var who := partner if partner != "" else crush
+	if who == "":
+		return "You don't have anyone to ask out."
+	if slot < 2:
+		return "Dates are in the evening."
+	if w.wallet < 80:
+		return "A date costs $80."
+	w.wallet -= 80
+	dates += 1
+	last_date = abs_day()
+	fun = minf(100.0, fun + 20.0)
+	social = minf(100.0, social + 25.0)
+	love = minf(100.0, love + (25.0 if drunk < 50.0 else 5.0))
+	var t := "Dinner and drinks with %s." % who
+	if partner == "" and love >= 45.0:
+		partner = who
+		crush = ""
+		w._news("LIFE: you and %s are official." % who)
+		w._post(w._fan_handle(), "%s has a new partner?? spotted at dinner downtown" % w.user_player.player_name, "fan", 1.3)
+		t += " You're officially together now."
+	elif drunk >= 50.0:
+		t += " You drank too much and it got awkward."
+	if w.user_player != null:
+		w.user_player.morale = minf(100.0, w.user_player.morale + 3.0)
+	spend(1)
+	return t
+
+
+## Each morning: a partner lifts your mood; neglect ends it.
+func _love_day() -> void:
+	if partner == "":
+		return
+	if abs_day() - last_date > 9:
+		love -= 6.0
+	if w.user_player != null:
+		w.user_player.morale = minf(100.0, w.user_player.morale + 0.4)
+	if love <= 0.0:
+		var who := partner
+		partner = ""
+		love = 0.0
+		if w.user_player != null:
+			w.user_player.morale = maxf(0.0, w.user_player.morale - 10.0)
+		w._news("LIFE: %s broke up with you. You never made time." % who)
+		_note("%s broke up with you." % who)
+
+
+func done_today(key: String) -> bool:
+	return int(used.get(key, -1)) == abs_day()
+
+
+func mark_today(key: String) -> void:
+	used[key] = abs_day()
+
+
+# --- Needs ---------------------------------------------------------------------
+
+func need(k: String) -> float:
+	return float(get(k))
+
+
+func add_need(k: String, d: float) -> void:
+	set(k, clampf(float(get(k)) + d, 0.0, 100.0))
+
+
+func eat(amount: float, cost: int = 0) -> String:
+	if cost > 0 and w.wallet < cost:
+		return "Need $%d" % cost
+	w.wallet -= cost
+	hunger = minf(100.0, hunger + amount)
+	hangover = maxf(0.0, hangover - amount * 0.25)
+	return ""
+
+
+# --- Drinking, smoking, drugs ----------------------------------------------------
+
+## Have something. from_stash: use your own supply (no cost); otherwise you pay.
+## Returns {ok, text}.
+func consume(id: String, from_stash: bool = false) -> Dictionary:
+	sync()
+	if not ITEMS.has(id):
+		return {"ok": false, "text": ""}
+	var it: Dictionary = ITEMS[id]
+	var kind := String(it.kind)
+	if from_stash:
+		if int(stash.get(id, 0)) <= 0:
+			return {"ok": false, "text": "You're out of that."}
+		stash[id] = int(stash[id]) - 1
+		if int(stash[id]) <= 0:
+			stash.erase(id)
+	else:
+		var c := int(it.cost)
+		if w.wallet < c:
+			return {"ok": false, "text": "You can't afford that."}
+		w.wallet -= c
+	var p := w.user_player
+	var tol := float(dep.get(kind, 0.0)) / 100.0
+	var t := ""
+	match kind:
+		"alcohol":
+			var add := float(it.drunk) * (1.0 - 0.35 * tol) * (1.25 if hunger < 30.0 else 1.0)
+			drunk = minf(100.0, drunk + add)
+			drunk_peak = maxf(drunk_peak, drunk)
+			week_drinks += 1
+			t = "%s. %s" % [String(it.name), drunk_text()]
+		"nicotine":
+			hangover = maxf(0.0, hangover - 3.0)
+			t = "You smoke a cigarette. Calmer for a bit."
+		"weed":
+			active["weed"] = int(it.slots)
+			t = "You smoke a joint. Everything slows down nicely."
+		"stim":
+			active["stim"] = int(it.slots)
+			crash.erase("stim")
+			energy = minf(100.0, energy + 25.0)
+			t = "You take a Vex. Wide awake, everything sharp."
+		"party":
+			active["party"] = int(it.slots)
+			energy = minf(100.0, energy + 15.0)
+			t = "You take a Blitz. The night lights up."
+	fun = minf(100.0, fun + float(it.get("fun", 0.0)) * (1.0 - 0.5 * tol))
+	social = minf(100.0, social + float(it.get("social", 0.0)))
+	dep[kind] = minf(100.0, float(dep.get(kind, 0.0)) + _dep_gain(kind))
+	last_use[kind] = abs_slot()
+	if it.has("trace"):
+		trace[kind] = maxi(int(trace.get(kind, 0)), int(it.trace))
+	if p != null and kind in BANNED:
+		w.soc().toxicity = minf(100.0, w.soc().toxicity + 1.0)
+	_clamp()
+	var extra := _after_use(kind)
+	if extra != "":
+		t += " " + extra
+	Game.save_player_career_soon()
+	return {"ok": true, "text": t, "blackout": extra.begins_with("You black out")}
+
+
+func _dep_gain(kind: String) -> float:
+	match kind:
+		"alcohol":
+			return 2.0
+		"nicotine":
+			return 3.5
+		"weed":
+			return 4.0
+		"stim":
+			return 9.0
+		"party":
+			return 7.0
+	return 2.0
+
+
+## Too much: blacking out, getting sick.
+func _after_use(kind: String) -> String:
+	if kind == "alcohol" and drunk >= 95.0:
+		return blackout()
+	if kind == "alcohol" and drunk >= 80.0 and w.rng.randf() < 0.25:
+		hunger = maxf(0.0, hunger - 30.0)
+		return "You throw up in the toilets. Classy."
+	return ""
+
+
+## You lose the rest of the night and wake up somewhere.
+func blackout() -> String:
+	var lost := mini(w.wallet, w.rng.randi_range(80, 600))
+	w.wallet -= lost
+	drunk_peak = 100.0
+	var where: String = ["on your kitchen floor", "in the back of a taxi you don't remember booking", "on a teammate's sofa", "in your bathtub, fully dressed"][w.rng.randi() % 4]
+	var fame_hit := false
+	if w.rng.randf() < 0.35 + float(w.fame) / 2000000.0:
+		fame_hit = true
+		w._post(w._fan_handle(), "is that %s passed out outside the club?? someone get him home" % w.user_player.player_name, "fan", 1.6)
+		w._trust(-4.0)
+		w.soc().toxicity = minf(100.0, w.soc().toxicity + 3.0)
+	if slot < 3:
+		slot = 3
+	sleep(4)
+	location = "home"
+	var t := "You black out. You wake up %s, $%d lighter." % [where, lost]
+	if fame_hit:
+		t += " Someone posted a video of you (coach trust -4)."
+	_note("Blacked out.")
+	return t
+
+
+func drunk_text() -> String:
+	if drunk >= 85.0:
+		return "You're absolutely hammered."
+	if drunk >= 60.0:
+		return "You're properly drunk."
+	if drunk >= 35.0:
+		return "You're tipsy."
+	if drunk >= 12.0:
+		return "You feel a little buzz."
+	return "Sober enough."
+
+
+func _hangover_text(peak: float) -> String:
+	if hangover >= 60.0:
+		return "Your head is pounding. A brutal hangover (last night: %d%% drunk)." % int(peak)
+	if hangover >= 30.0:
+		return "You're hungover."
+	return "A bit rough this morning."
+
+
+## Kinds you're craving right now (dependent and it's been a while).
+func cravings() -> Array:
+	var out: Array = []
+	for k: String in dep:
+		var d := float(dep[k])
+		if d < 35.0:
+			continue
+		var since := abs_slot() - int(last_use.get(k, -100))
+		var wait := 6 if k == "nicotine" else 10
+		if since > int(wait * (1.4 - d / 100.0)):
+			out.append(k)
+	return out
+
+
+func addicted_to() -> Array:
+	var out: Array = []
+	for k: String in dep:
+		if float(dep[k]) >= 60.0:
+			out.append(k)
+	return out
+
+
+func stash_text() -> String:
+	var parts: Array = []
+	for id: String in stash:
+		parts.append("%s x%d" % [String(ITEMS[id].name), int(stash[id])])
+	return ", ".join(parts) if not parts.is_empty() else "Empty"
+
+
+func buy_pack(id: String) -> String:
+	if not STASH_PACKS.has(id):
+		return "Not sold here"
+	var pk: Dictionary = STASH_PACKS[id]
+	if w.wallet < int(pk.cost):
+		return "Need $%d" % int(pk.cost)
+	w.wallet -= int(pk.cost)
+	stash[id] = int(stash.get(id, 0)) + int(pk.n)
+	return ""
+
+
+## From a dealer: into your stash. Small chance it's a setup when you're famous.
+func buy_drug(id: String, n: int = 1) -> String:
+	if not ITEMS.has(id) or String(ITEMS[id].kind) not in ["weed", "stim", "party"]:
+		return "He doesn't have that"
+	var cost := int(ITEMS[id].cost) * n
+	if w.wallet < cost:
+		return "Need $%d" % cost
+	w.wallet -= cost
+	stash[id] = int(stash.get(id, 0)) + n
+	if w.rng.randf() < 0.04 + float(w.fame) / 4000000.0:
+		w._post(World.OUTLET_HANDLES.pick_random(), "EXCLUSIVE: photos appear to show %s buying drugs outside a nightclub." % w.user_player.player_name, "press", 2.2)
+		w._trust(-8.0)
+		_scandal("photographed buying drugs", 0.5)
+		return "Bought. Then you notice the camera flash across the street."
+	return ""
+
+
+# --- Status for HUDs -----------------------------------------------------------
+
+## Short status tags: [text, severity 0 good / 1 warn / 2 bad].
+func status_tags() -> Array:
+	var out: Array = []
+	if drunk >= 12.0:
+		out.append([drunk_text().trim_suffix(".").replace("You're ", "").replace("You feel ", "").capitalize(), 2 if drunk >= 60.0 else 1])
+	if hangover >= 15.0:
+		out.append(["Hungover", 2 if hangover >= 50.0 else 1])
+	if active.has("weed"):
+		out.append(["High", 1])
+	if active.has("stim"):
+		out.append(["Wired (Vex)", 1])
+	if active.has("party"):
+		out.append(["Rolling (Blitz)", 1])
+	if crash.has("stim"):
+		out.append(["Crashing", 2])
+	if crash.has("party"):
+		out.append(["Comedown", 2])
+	for k: String in cravings():
+		out.append(["Craving %s" % KIND_NAMES.get(k, k), 1])
+	if energy < 20.0:
+		out.append(["Exhausted", 2])
+	if hunger < 20.0:
+		out.append(["Starving", 2])
+	if out.is_empty() and energy >= 70.0 and hunger >= 50.0 and fun >= 40.0:
+		out.append(["Feeling fresh", 0])
+	return out
+
+
+## Camera wobble 0..1 for walking/driving scenes.
+func wobble() -> float:
+	return clampf(drunk / 100.0 + (0.25 if active.has("party") else 0.0) + (0.1 if active.has("weed") else 0.0), 0.0, 1.0)
+
+
+# --- Matches -----------------------------------------------------------------
+
+## What your state does to a match: rating (added to match_mod), crosshair
+## sway (deg), camera wobble, extra spread (deg), move speed multiplier.
+func match_mods() -> Dictionary:
+	sync()
+	var r := 0.0
+	var sway := 0.0
+	var wob := 0.0
+	var spread := 0.0
+	var speed := 1.0
+	var notes: Array = []
+	if drunk >= 5.0:
+		r -= drunk * 0.09
+		sway += drunk * 0.06
+		wob += drunk / 140.0
+		spread += drunk * 0.035
+		speed -= drunk * 0.0012
+		notes.append("drunk (%d%%)" % int(drunk))
+	if hangover >= 5.0:
+		r -= hangover * 0.05
+		sway += hangover * 0.015
+		spread += hangover * 0.015
+		notes.append("hungover")
+	if active.has("weed"):
+		r -= 3.0
+		sway += 1.2
+		spread += 0.8
+		notes.append("high")
+	if active.has("stim"):
+		r += 3.5
+		spread -= 0.6
+		speed += 0.03
+		notes.append("on Vex")
+	if crash.has("stim"):
+		r -= 4.5
+		sway += 0.8
+		notes.append("crashing")
+	if active.has("party"):
+		r -= 2.5
+		sway += 1.6
+		wob += 0.25
+		notes.append("on Blitz")
+	if crash.has("party"):
+		r -= 4.0
+		spread += 0.5
+		notes.append("Blitz comedown")
+	if not cravings().is_empty():
+		r -= 2.5
+		sway += 0.6
+		notes.append("withdrawal")
+	if energy < 35.0:
+		r -= (35.0 - energy) * 0.12
+		spread += (35.0 - energy) * 0.02
+		notes.append("tired")
+	if hunger < 25.0:
+		r -= 2.0
+		notes.append("hungry")
+	if notes.is_empty() and energy >= 70.0 and hunger >= 45.0 and fun >= 35.0:
+		r += 1.5
+		notes.append("fresh")
+	return {"rating": r, "sway": minf(sway, 9.0), "wobble": clampf(wob, 0.0, 1.0), "spread": clampf(spread, -1.0, 6.0),
+		"speed": clampf(speed, 0.85, 1.05), "notes": notes}
+
+
+func match_mods_text() -> String:
+	var m := match_mods()
+	if (m.notes as Array).is_empty():
+		return "Normal"
+	return "%s (%+.1f)" % [", ".join(m.notes), float(m.rating)]
+
+
+## Match day, before the lineup: a random drug test (more likely in cups).
+## Positive for Vex or Blitz: banned. Weed: a fine.
+func drug_test(mt: Dictionary, force: bool = false) -> String:
+	if (tested == w.stamp() and not force) or w.teamless:
+		return ""
+	tested = w.stamp()
+	var chance := 0.12 if String(mt.get("kind", "league")) == "league" else 0.35
+	if not force and w.rng.randf() >= chance:
+		return ""
+	var me := w.user_player
+	var hit := ""
+	for k: String in BANNED:
+		if trace.has(k):
+			hit = k
+	if hit != "":
+		var weeks := 6 if bans == 0 else 12
+		bans += 1
+		w.forced_bench_until = maxi(w.forced_bench_until, w.stamp() + weeks)
+		var fine := mini(w.wallet, maxi(2000, me.salary * 2))
+		w.wallet -= fine
+		w._trust(-20.0)
+		_scandal("failing a drug test", 1.0)
+		for d: Dictionary in w.endorsements.duplicate():
+			w.endorsements.erase(d)
+			w._msg("endorse", "%s have dropped you" % d.brand, "%s have ended your deal after your failed drug test." % d.brand, [["OK", "ok"]], me.uid)
+		w._post(World.OUTLET_HANDLES.pick_random(), "BANNED: %s fails a match-day drug test (%s) and is suspended for %d weeks." % [me.player_name, KIND_NAMES[hit], weeks], "press", 2.6)
+		w._msg("bench", "Failed drug test", "Your match-day sample came back positive for %s. You're suspended for %d weeks and fined $%s. Your sponsors have walked." % [KIND_NAMES[hit], weeks, World._fmt(fine)], [["OK", "ok"]], me.uid)
+		w._news("BANNED: you failed a drug test (%s). Suspended for %d weeks." % [KIND_NAMES[hit], weeks])
+		w._apply_coach()
+		_note("Failed a drug test.")
+		return "failed"
+	if trace.has("weed"):
+		var f2 := mini(w.wallet, 1500)
+		w.wallet -= f2
+		w._trust(-6.0)
+		w._msg("bench", "Drug test: warning", "Your match-day test showed weed. It isn't a banned substance here, but the club has fined you $%s and the coach wants it to stop." % World._fmt(f2), [["OK", "ok"]], me.uid)
+		w._news("DRUG TEST: weed in your sample. Fined, warned.")
+		return "warned"
+	w._news("DRUG TEST: you were tested before the match. Clean.")
+	return "clean"
+
+
+## Called from World.prepare_match_day (player mode): your state on the day.
+func apply_match_day() -> void:
+	var m := match_mods()
+	w.user_player.match_mod += float(m.rating)
+	if not (m.notes as Array).is_empty() and float(m.rating) < -2.0:
+		w._news("MATCHDAY: you turn up %s (%+.1f)." % [", ".join(m.notes), float(m.rating)])
+	if (drunk >= 40.0 or crash.has("party")) and not w.teamless and w.rng.randf() < 0.6:
+		w._trust(-10.0)
+		w.soc().toxicity = minf(100.0, w.soc().toxicity + 5.0)
+		w._post(w._fan_handle(), "was %s drunk on stream?? he could barely stand" % w.user_player.player_name, "fan", 1.5)
+		w._news("MATCHDAY: everyone could tell you weren't right. Coach trust -10.")
+
+
+# --- Trouble -------------------------------------------------------------------
+
+func _scandal(why: String, size: float) -> void:
+	var lost := int(w.fame * 0.03 * size)
+	w.fame = maxi(50, w.fame - lost)
+	w.soc().toxicity = minf(100.0, w.soc().toxicity + 8.0 * size)
+	w._news("SCANDAL: %s." % why)
+
+
+## Leaving a night out: were you seen? Called by venues on exit.
+func night_out_done(venue: String) -> String:
+	nights_out += 1
+	var me := w.user_player
+	var risk := 0.06 + float(w.fame) / 1500000.0
+	var bad := drunk >= 60.0 or active.has("party") or active.has("weed")
+	if bad:
+		risk += 0.25
+	if nights_out >= 3:
+		risk += 0.1
+	if w.rng.randf() >= risk:
+		return ""
+	var t := ""
+	if bad:
+		var what := "high" if (active.has("party") or active.has("weed")) else "wasted"
+		w._post(World.OUTLET_HANDLES.pick_random(), "PICTURED: %s stumbling out of %s at 3am, looking %s." % [me.player_name, venue, what], "press", 1.8)
+		w._trust(-6.0)
+		_scandal("photographed %s outside %s" % [what, venue], 0.6)
+		t = "Paparazzi caught you leaving, looking %s. Coach trust -6." % what
+	else:
+		var f := int(150 + w.fame * 0.002)
+		w._gain_fame(f)
+		w._post(w._fan_handle(), "saw %s out at %s last night, so chill, took a pic with me" % [me.player_name, venue], "fan", 1.1)
+		t = "A fan got a photo with you: +%s followers." % World.fame_text(f)
+	return t
+
+
+## Weekday mornings: show up to practice hungover and the coach may notice.
+func _coach_notices() -> void:
+	if w.teamless or day >= 5:
+		return
+	if hangover >= 45.0 and w.rng.randf() < 0.35:
+		w._trust(-3.0)
+		w._news("PRACTICE: the coach could smell last night on you. Trust -3.")
+	if nights_out >= 3 and day == 4 and w.rng.randf() < 0.5:
+		w._trust(-4.0)
+		w._msg("coach", "A word", "Three nights out this week? I'm not your dad, but I pick the team. Sort it out.", [["OK", "ok"]], w.user_player.uid)
+	if not addicted_to().is_empty() and w.rng.randf() < 0.08:
+		w._msg("coach", "We're worried", "People have noticed. If you need help, the club will pay for rehab, no questions asked. Your phone has the number.", [["OK", "ok"]], w.user_player.uid)
+
+
+## Drink driving caught by the police (city scene).
+func dui(what: String) -> String:
+	var me := w.user_player
+	var fine := mini(w.wallet, 5000 + me.salary)
+	w.wallet -= fine
+	licence_until = abs_week() + 4
+	w._trust(-12.0)
+	_scandal("arrested for %s" % what, 1.0)
+	w._post(World.OUTLET_HANDLES.pick_random(), "ARRESTED: %s pulled over and charged with %s. Licence suspended." % [me.player_name, what], "press", 2.4)
+	w._news("POLICE: you were caught %s. Fined $%s, licence suspended for 4 weeks." % [what, World._fmt(fine)])
+	_note("Arrested for %s." % what)
+	return "Pulled over: %s. Fined $%s, licence suspended for 4 weeks, and it's all over the news." % [what, World._fmt(fine)]
+
+
+func can_drive() -> bool:
+	return abs_week() >= licence_until
+
+
+func impaired() -> bool:
+	return drunk >= 25.0 or active.has("weed") or active.has("party")
+
+
+## A week in rehab: dependence gone, the week passes (the club covers your match).
+func rehab() -> String:
+	var cost := 20000
+	if w.wallet < cost and w.teamless:
+		return "Rehab costs $%s" % World._fmt(cost)
+	if not w.teamless:
+		cost = 0 # The club pays.
+	w.wallet -= cost
+	dep.clear()
+	crash.clear()
+	active.clear()
+	drunk = 0.0
+	hangover = 0.0
+	w._trust(4.0)
+	w.user_player.morale = minf(100.0, w.user_player.morale + 10.0)
+	w._news("REHAB: you spent a week getting clean.")
+	w._post(w._fan_handle(), "respect to %s for getting help. proud of him" % w.user_player.player_name, "fan", 1.2)
+	if has_match():
+		w.sim_user_match()
+	var adv := w.advance_week()
+	if adv == "play_match":
+		w.sim_user_match()
+		w.advance_week()
+	week_stamp = w.stamp()
+	day = 0
+	slot = 0
+	energy = 90.0
+	hunger = 80.0
+	fun = 60.0
+	Game.save_player_career_soon()
+	return "A week in rehab. Clean, rested, and the cravings are gone."
+
+
+func _note(t: String) -> void:
+	log.append("%s: %s" % [short_time(), t])
+	while log.size() > 20:
+		log.pop_front()
+
