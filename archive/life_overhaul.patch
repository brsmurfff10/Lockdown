+	s.drunk_peak = float(d.get("drp", 0.0))
+	s.hangover = float(d.get("hg", 0.0))
+	for key in ["act", "cr", "lu", "tr", "st", "used"]:
+		var src: Dictionary = d.get(key, {})
+		var dst: Dictionary = {"act": s.active, "cr": s.crash, "lu": s.last_use, "tr": s.trace, "st": s.stash, "used": s.used}[key]
+		for k in src:
+			dst[String(k)] = int(src[k])
+	var dd: Dictionary = d.get("dep", {})
+	for k in dd:
+		s.dep[String(k)] = float(dd[k])
+	s.licence_until = int(d.get("lic", 0))
+	s.tested = int(d.get("tested", -1))
+	for l in d.get("log", []):
+		s.log.append(String(l))
+	s.location = String(d.get("loc", "home"))
+	s.nights_out = int(d.get("no", 0))
+	s.week_drinks = int(d.get("wd", 0))
+	s.no_shows = int(d.get("ns", 0))
+	s.bans = int(d.get("bans", 0))
+	s.car_at = String(d.get("car", "home"))
+	s.team_night = int(d.get("tn", -1))
+	s.crush = String(d.get("crush", ""))
+	s.partner = String(d.get("partner", ""))
+	s.love = float(d.get("love", 0.0))
+	s.last_date = int(d.get("ld", -100))
+	s.dates = int(d.get("dates", 0))
+	return s
