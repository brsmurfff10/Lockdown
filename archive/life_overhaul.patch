+++ b/tests/life_probe.gd
@@ -0,0 +1,274 @@
+extends Node
+## My Player life: days and slots, needs, home actions, drinking and
+## hangovers, drugs and drug tests, match day (mods, sway), no-shows, rehab,
+## save/load, every venue walkable, the city (driving, GPS, police).
+##   godot --headless --path . res://tests/life_probe.tscn -- --test
+var fails := 0
+
+
+func _check(ok: bool, what: String) -> void:
+	print("%s  %s" % ["PASS" if ok else "FAIL", what])
+	if not ok:
+		fails += 1
+
+
+func _ready() -> void:
+	Game.end_career()
+	Game.create_my_player("Nightlife", "Rifler", "Canada")
+	Game.start_career()
+	var w := Game.pworld
+	var life := w.life()
+	var sim := life.sim
+	sim.sync()
+	_check(sim.day == 0 and sim.slot == 0, "career starts on %s" % sim.time_text())
+
+	# --- Home actions use time and needs.
+	var h0 := sim.hunger
+	var r := life.act("pc")
+	_check(bool(r.ok) and sim.slot == 1, "aim practice takes a slot: %s" % sim.time_text())
+	_check(not bool(life.act("pc").ok), "aim practice once a day")
+	sim.hunger = 30.0
+	var rk := life.act("kitchen")
+	_check(bool(rk.ok) and sim.hunger > 70.0, "cooking fills you up (%.0f -> %.0f)" % [30.0, sim.hunger])
+	_check(sim.slot == 1, "eating at home is quick (still %s)" % sim.time_text())
+	var rb := life.act("bed")
+	_check(sim.day == 1 and sim.slot == 0, "sleep: next morning (%s) - %s" % [sim.time_text(), rb.text])
+	_check(bool(life.act("pc").ok), "aim practice again the next day")
+
+	# --- A night out: drinks, time flies, hangover, match effects.
+	sim.slot = 2
+	w.wallet = 100000
+	for i in 3:
+		Venues.drink(w, "shots")
+	_check(sim.drunk >= 50.0, "three rounds of shots: drunk %.0f (%s)" % [sim.drunk, sim.drunk_text()])
+	_check(sim.day == 2 or sim.slot == 0 or sim.slot >= 3, "time flies while drinking: %s" % sim.time_text())
+	var mods := sim.match_mods()
+	_check(float(mods.rating) < -4.0 and float(mods.sway) > 2.0 and float(mods.wobble) > 0.3, "drunk at a match: %s" % str(mods))
+	sim.sleep(10)
+	_check(sim.hangover > 20.0 and sim.drunk == 0.0, "next morning: hangover %.0f, sober" % sim.hangover)
+	_check(float(sim.match_mods().rating) < -1.0, "hungover at a match: %s" % sim.match_mods_text())
+	_check(sim.status_tags().any(func(t: Array) -> bool: return String(t[0]) == "Hungover"), "HUD shows Hungover")
+	var hg0 := sim.hangover
+	sim.spend(3)
+	_check(sim.hangover < hg0 - 30.0, "hangover wears off through the day (%.0f -> %.0f)" % [hg0, sim.hangover])
+	# Blacking out.
+	sim.slot = 2
+	for i in 8:
+		if bool(Venues.drink(w, "shots").get("blackout", false)):
+			break
+	_check(sim.slot == 0 and sim.drunk == 0.0 and sim.log.any(func(l: String) -> bool: return l.contains("Blacked out")), "too many shots: blackout, wake up the next morning (%s)" % sim.time_text())
+	sim.hangover = 0.0
+
+	# --- Drugs and a drug test.
+	_check(sim.buy_drug("vex") == "" or sim.stash.has("vex"), "bought Vex from a dealer")
+	_check(int(sim.stash.get("vex", 0)) >= 1, "Vex in the stash")
+	var rc := sim.consume("vex", true)
+	_check(bool(rc.ok) and sim.active.has("stim") and sim.trace.has("stim"), "took Vex: wired, traceable")
+	_check(float(sim.match_mods().rating) > 0.0, "on Vex you play sharper: %s" % sim.match_mods_text())
+	sim.spend(3)
+	_check(sim.crash.has("stim") and float(sim.match_mods().rating) < 0.0, "then the crash: %s" % sim.match_mods_text())
+	var mt := w.user_match_this_week()
+	var res := sim.drug_test(mt if not mt.is_empty() else {"kind": "league"}, true)
+	_check(res == "failed" and w.forced_bench_until > w.stamp(), "drug test: %s, suspended until %d (now %d)" % [res, w.forced_bench_until, w.stamp()])
+	_check(w.user_play_block() != "", "suspended: can't play (%s)" % w.user_play_block())
+	w.forced_bench_until = 0
+	w._apply_coach()
+	sim.trace.clear()
+	sim.crash.clear()
+	sim.active.clear()
+
+	# --- Match day.
+	var wk := w.stamp()
+	if not sim.has_match():
+		sim.skip_week()
+	var guard := 0
+	while not sim.has_match() and guard < 6:
+		guard += 1
+		w.advance_week()
+		sim.sync()
+	_check(sim.has_match(), "a week with a match (week %d)" % w.week)
+	_check(not sim.is_match_time(), "not match time on %s" % sim.time_text())
+	sim.skip_to_match()
+	_check(sim.is_match_time(), "skipped to match time: %s" % sim.time_text())
+	sim.drunk = 50.0
+	_check(Game.prepare_player_match() or w.user_play_block() != "", "match prepared")
+	var lf: Dictionary = Game.pending_match.get("life", {})
+	_check(String(Game.pending_match.get("mode", "")) != "career" or float(lf.get("sway", 0.0)) > 1.0, "drunk sway reaches the match: %s" % str(lf))
+	Game.pending_match = {}
+	sim.drunk = 0.0
+	w.sim_user_match()
+	sim.after_match()
+	_check(sim.day == LifeSim.MATCH_DAY and sim.slot == 3, "after the match: %s" % sim.time_text())
+	wk = w.stamp()
+	sim.skip_week()
+	_check(w.stamp() != wk and sim.day == 0 and sim.slot == 0, "slept through to next week: week %d, %s" % [w.week, sim.time_text()])
+
+	# --- Missing your match.
+	guard = 0
+	while not sim.has_match() and guard < 6:
+		guard += 1
+		w.advance_week()
+		sim.sync()
+	var trust0 := w.coach_trust
+	sim.day = 6
+	sim.slot = 3
+	wk = w.stamp()
+	sim.sleep(8)
+	_check(w.stamp() != wk and sim.no_shows == 1, "never turned up: the week went on without you (no-shows %d)" % sim.no_shows)
+	_check(w.coach_trust < trust0, "coach trust down after a no-show (%.0f -> %.0f)" % [trust0, w.coach_trust])
+
+	# --- Dependence, cravings, rehab.
+	for i in 14:
+		sim.consume("cig", false)
+	_check(float(sim.dep.get("nicotine", 0.0)) > 35.0, "hooked on nicotine: %.0f" % float(sim.dep.get("nicotine", 0.0)))
+	sim.spend(3)
+	sim.sleep(8)
+	sim.spend(2)
+	_check(sim.cravings().has("nicotine"), "craving after a while: %s" % str(sim.cravings()))
+	sim.dep["nicotine"] = 70.0
+	wk = w.stamp()
+	var rr := sim.rehab()
+	_check(sim.dep.is_empty() and w.stamp() != wk, "rehab: clean, a week passed (%s) dep=%s week %d->%d" % [rr, str(sim.dep), wk, w.stamp()])
+
+	# --- Save and load.
+	sim.stash = {"beer": 4}
+	sim.drunk = 33.0
+	sim.car_at = "bar"
+	var d := w.to_dict()
+	var w2 := World.from_dict(JSON.parse_string(JSON.stringify(d)))
+	var s2 := w2.life().sim
+	_check(int(s2.stash.get("beer", 0)) == 4 and is_equal_approx(s2.drunk, 33.0) and s2.car_at == "bar" and s2.day == sim.day, "life saved and loaded")
+	sim.drunk = 0.0
+
+	# --- Venues: open hours, every use reachable, people there.
+	_check(not Venues.is_open("club", 0) and Venues.is_open("club", 3) and Venues.is_open("diner", 0), "opening hours (club nights only)")
+	var scene: PackedScene = load("res://scenes/home.tscn")
+	for id: String in Venues.IDS:
+		Game.venue = id
+		sim.slot = 2 if id != "gym" and id != "training" else 1
+		var hm: Home = scene.instantiate()
+		add_child(hm)
+		await get_tree().process_frame
+		_check(hm.venue == id and hm.items.size() >= 4, "%s loads (%d pieces)" % [id, hm.items.size()])
+		var uses := {}
+		for it: Dictionary in hm.items:
+			if String(it.use) != "":
+				uses[String(it.use)] = it
+		var unreachable: Array = []
+		var from := Vector2i(hm.pos / Home.CELL)
+		for u: String in uses:
+			var rect: Rect2 = uses[u].rect
+			var ok := false
+			for y in hm.H:
+				for x in hm.W:
+					var c := Vector2i(x, y)
+					if ok or hm.is_solid(c):
+						continue
+					var p := hm.cell_center(c)
+					if not rect.grow(Home.REACH).has_point(p):
+						continue
+					if hm.astar.get_id_path(from, c).size() > 0 or c == from:
+						ok = true
+			if not ok:
+				unreachable.append(u)
+		_check(unreachable.is_empty(), "%s: every spot reachable %s" % [id, str(unreachable)])
+		_check(not hm.npcs.is_empty(), "%s: people inside (%d)" % [id, hm.npcs.size()])
+		hm.queue_free()
+		await get_tree().process_frame
+	Game.venue = ""
+	sim.slot = 0
+	var dr := Venues.act(w, "dance")
+	_check(bool(dr.ok), "dance: %s" % dr.text)
+	var wo := Venues.act(w, "workout")
+	_check(bool(wo.ok) and not bool(Venues.act(w, "workout").ok), "workout once a day: %s" % wo.text)
+	var pro := {"kind": "pro", "p": w.teams[1].roster[0], "name": w.teams[1].roster[0].player_name}
+	var tr := Venues.talk(w, pro, "trash")
+	_check(tr.contains(":"), "talk shit to a pro: %s" % tr)
+
+	# --- Dating.
+	sim.slot = 3
+	var got := false
+	for i in 30:
+		sim.used.clear()
+		if sim.flirt("Mia").contains("number"):
+			got = true
+			break
+	_check(got and sim.crush == "Mia", "flirting: got Mia's number")
+	sim.slot = 2
+	sim.date()
+	sim.slot = 2
+	sim.date()
+	_check(sim.partner == "Mia", "two good dates: together (love %.0f)" % sim.love)
+	sim.love = 5.0
+	sim.last_date = sim.abs_day() - 20
+	sim.sleep(8)
+	_check(sim.partner == "", "neglected: Mia broke up with you")
+	# Team night out after a win.
+	var ut := w.user_team()
+	if ut != null and not w.teamless:
+		ut.streak = 1
+		sim.team_night = -1
+		sim.day = LifeSim.MATCH_DAY
+		sim.slot = LifeSim.MATCH_SLOT
+		sim.after_match()
+		var crowd := Venues.patrons(w, "bar")
+		var mates_there := crowd.filter(func(o: Dictionary) -> bool: return String(o.kind) == "mate").size()
+		_check(sim.team_out_tonight() and mates_there >= 4, "won: the team is at the bar tonight (%d teammates)" % mates_there)
+		Game.pending_toast = ""
+
+	# --- The city.
+	sim.slot = 3
+	Game.city_spawn = "home"
+	Game.city_on_foot = true
+	var cs: PackedScene = load("res://scenes/city.tscn")
+	var city: City = cs.instantiate()
+	add_child(city)
+	await get_tree().process_frame
+	_check(city.places.size() == City.PLACES.size(), "city: %d places" % city.places.size())
+	var bad_doors: Array = []
+	for id: String in city.places:
+		if city.solid_at(city.places[id].door, City.FOOT_R):
+			bad_doors.append(id)
+	_check(bad_doors.is_empty(), "every door is on the walkway %s" % str(bad_doors))
+	_check(city.tile_at(city.places["bar"].park) == City.ROAD, "parking spots are on the road")
+	city.waypoint = "club"
+	city._update_gps()
+	_check(city.gps.size() > 5, "GPS route home -> club: %d steps" % city.gps.size())
+	var p0 := city.foot_pos
+	Input.action_press("move_down")
+	for i in 30:
+		city._process(1.0 / 30.0)
+	Input.action_release("move_down")
+	_check(city.foot_pos.distance_to(p0) > 20.0, "walking moves you (%.0f px)" % city.foot_pos.distance_to(p0))
+	# Driving: give the player a car and drive.
+	w.assets.append("car")
+	sim.car_at = "home"
+	city.queue_free()
+	await get_tree().process_frame
+	Game.city_on_foot = false
+	city = cs.instantiate()
+	add_child(city)
+	await get_tree().process_frame
+	_check(city.in_car and city.has_car, "spawned in your car")
+	var c0 := city.car_pos
+	Input.action_press("move_up")
+	for i in 60:
+		city._process(1.0 / 30.0)
+	Input.action_release("move_up")
+	_check(city.car_pos.distance_to(c0) > 80.0, "driving moves the car (%.0f px, %d km/h)" % [city.car_pos.distance_to(c0), int(city.car_speed * 0.25)])
+	_check(not city.traffic.is_empty() and city.traffic.any(func(t: Dictionary) -> bool: return bool(t.police)), "traffic and police on the road")
+	# Drink driving next to a police car.
+	sim.drunk = 60.0
+	var cop: Dictionary = city.traffic.filter(func(t: Dictionary) -> bool: return bool(t.police))[0]
+	cop.pos = city.car_pos + Vector2(60, 0)
+	city.car_speed = 200.0
+	city._police_cd = 0.0
+	city._police_tick(0.1)
+	_check(city.frozen and not sim.can_drive() and not city.in_car, "drink driving: pulled over, licence suspended")
+	city.queue_free()
+	await get_tree().process_frame
+	sim.drunk = 0.0
+
+	print("LIFE: %s (%d failed)" % ["PASS" if fails == 0 else "FAIL", fails])
+	Game.end_career()
+	get_tree().quit(1 if fails > 0 else 0)
