+func to_dict() -> Dictionary:
+	return {"day": day, "slot": slot, "ws": week_stamp, "en": energy, "hu": hunger, "fun": fun, "so": social,
+		"dr": drunk, "drp": drunk_peak, "hg": hangover, "act": active.duplicate(), "cr": crash.duplicate(), "dep": dep.duplicate(),
+		"lu": last_use.duplicate(), "tr": trace.duplicate(), "st": stash.duplicate(), "used": used.duplicate(), "lic": licence_until,
+		"tested": tested, "log": log.duplicate(), "loc": location, "no": nights_out, "wd": week_drinks, "ns": no_shows, "bans": bans, "car": car_at,
+		"tn": team_night, "crush": crush, "partner": partner, "love": love, "ld": last_date, "dates": dates}
