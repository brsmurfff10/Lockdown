+# --- GPS -----------------------------------------------------------------------------
+
+func _update_gps() -> void:
+	gps = PackedVector2Array()
+	if waypoint == "" or not places.has(waypoint):
+		return
+	var goal: Vector2 = places[waypoint].door
+	if _me().distance_to(goal) < 80.0:
+		waypoint = ""
+		return
+	# BFS over walkable tiles (roads first: cheap and good enough at this size).
+	var start := Vector2i(_me() / T)
+	var end := Vector2i(goal / T)
+	var prev := {}
+	var q: Array[Vector2i] = [start]
+	prev[start] = start
+	var found := false
+	var head := 0
+	while head < q.size():
+		var c := q[head]
+		head += 1
+		if c == end:
+			found = true
+			break
+		for d: Vector2i in [Vector2i(1, 0), Vector2i(-1, 0), Vector2i(0, 1), Vector2i(0, -1)]:
+			var n := c + d
+			if prev.has(n) or tile(n) in SOLID:
+				continue
+			prev[n] = c
+			q.append(n)
+	if not found:
+		return
+	var c2 := end
+	var guard := 0
+	while c2 != start and guard < 4000:
+		guard += 1
+		gps.insert(0, (Vector2(c2) + Vector2(0.5, 0.5)) * T)
+		c2 = prev[c2]
+
+
+# --- Drawing ---------------------------------------------------------------------------
+
+func _apply_light() -> void:
+	var cols := [Color(1.0, 0.96, 0.9), Color(1, 1, 1), Color(0.86, 0.7, 0.6), Color(0.26, 0.3, 0.48)]
+	modulate_node.color = cols[clampi(sim.slot, 0, 3)]
+
+
+func _radial() -> GradientTexture2D:
+	var g := Gradient.new()
+	g.set_color(0, Color(1, 1, 1, 1))
+	g.set_color(1, Color(1, 1, 1, 0))
+	g.add_point(0.45, Color(1, 1, 1, 0.45))
+	var t := GradientTexture2D.new()
+	t.gradient = g
+	t.fill = GradientTexture2D.FILL_RADIAL
+	t.fill_from = Vector2(0.5, 0.5)
+	t.fill_to = Vector2(1.0, 0.5)
+	t.width = 256
+	t.height = 256
+	return t
+
+
+## Street lamps and headlights at dusk and night (2D lights, pooled near the camera).
+func _make_lights() -> void:
+	var tex := _radial()
+	for i in 10:
+		var l := PointLight2D.new()
+		l.texture = tex
+		l.texture_scale = 1.6
+		l.color = Color(1.0, 0.82, 0.55)
+		add_child(l)
+		lamp_lights.append(l)
+	for i in 6:
+		var c := PointLight2D.new()
+		c.texture = tex
+		c.texture_scale = 0.9
+		c.scale = Vector2(1.8, 0.8)
+		c.color = Color(1.0, 0.95, 0.8)
+		add_child(c)
+		car_lights.append(c)
+	head_light = PointLight2D.new()
+	head_light.texture = tex
+	head_light.texture_scale = 1.4
+	head_light.scale = Vector2(2.2, 1.0)
+	head_light.color = Color(1.0, 0.96, 0.85)
+	add_child(head_light)
+	_lights_tick(1.0)
+
+
+func _lights_tick(delta: float) -> void:
+	var e := 1.0 if sim.slot >= 3 else (0.55 if sim.slot == 2 else 0.0)
+	var on := e > 0.0
+	head_light.visible = on and in_car
+	if in_car:
+		head_light.position = car_pos + Vector2.from_angle(car_ang) * 110.0
+		head_light.rotation = car_ang
+		head_light.energy = 1.5 * e
+	var view := cam.global_position if cam != null else _me()
+	var near: Array = traffic.filter(func(c: Dictionary) -> bool: return (c.pos as Vector2).distance_to(view) < 1100.0)
+	for i in car_lights.size():
+		var l := car_lights[i]
+		l.visible = on and i < near.size()
+		if l.visible:
+			var c: Dictionary = near[i]
+			var ang := Vector2(c.dir).angle()
+			l.position = (c.pos as Vector2) + Vector2.from_angle(ang) * 70.0
+			l.rotation = ang
+			l.energy = 0.8 * e
+	_light_t -= delta
+	if _light_t > 0.0:
+		return
+	_light_t = 0.3
+	var ls := lamps.duplicate()
+	ls.sort_custom(func(a: Vector2, b: Vector2) -> bool: return a.distance_squared_to(view) < b.distance_squared_to(view))
+	for i in lamp_lights.size():
+		var l2 := lamp_lights[i]
+		l2.visible = on and i < ls.size()
+		if l2.visible:
+			l2.position = ls[i]
+			l2.energy = 0.9 * e
+
+
+func draw_map(c: CanvasItem) -> void:
+	var f := ThemeDB.fallback_font
+	c.draw_rect(Rect2(-2000, -2000, MW * T + 4000, MH * T + 4000), Color("1d3b52"))
+	for y in MH:
+		for x in MW:
+			var r := Rect2(x * T, y * T, T, T)
+			match tile(Vector2i(x, y)):
+				ROAD:
+					c.draw_rect(r, Color("2b2d31"))
+				WALKWAY:
+					c.draw_rect(r, Color("9a9a96"))
+					c.draw_rect(r, Color(0, 0, 0, 0.08), false, 1.0)
+				GRASS:
+					c.draw_rect(r, Color("4d8a3f"))
+				LOT:
+					c.draw_rect(r, Color("3a3c40"))
+					c.draw_line(r.position + Vector2(4, 0), r.position + Vector2(4, T * 0.6), Color(1, 1, 1, 0.5), 2.0)
+				WATER:
+					c.draw_rect(r, Color("1f5f8b"))
+				BUILDING:
+					c.draw_rect(r, Color("44474f"))
+	# Lane markings.
+	for col: int in COLS:
+		var x := col * T
+		var y := 0.0
+		while y < (MH - 2) * T:
+			if not _near_row(y):
+				c.draw_line(Vector2(x, y), Vector2(x, y + 22.0), Color("e8c547"), 2.0)
+			y += 44.0
+	for row: int in ROWS:
+		var y2 := row * T
+		var x2 := 0.0
+		while x2 < MW * T:
+			if not _near_col(x2):
+				c.draw_line(Vector2(x2, y2), Vector2(x2 + 22.0, y2), Color("e8c547"), 2.0)
+			x2 += 44.0
+	# Crossings.
+	for col: int in COLS:
+		for row: int in ROWS:
+			for i in 5:
+				var yy := (row - 1) * T + 12.0 + i * 22.0
+				c.draw_rect(Rect2((col + 1) * T + 4.0, yy, 20.0, 10.0), Color(1, 1, 1, 0.55))
+	# Buildings.
+	for b: Dictionary in blocks_art:
+		var r2: Rect2 = b.rect
+		c.draw_rect(Rect2(r2.position + Vector2(5, 6), r2.size), Color(0, 0, 0, 0.35))
+		c.draw_rect(r2, b.color)
+		c.draw_rect(r2.grow(-6), (b.color as Color).darkened(0.15))
+		c.draw_rect(Rect2(r2.position + Vector2(12, 12), Vector2(18, 14)), (b.color as Color).lightened(0.2))
+	for id: String in places:
+		var pd: Dictionary = places[id]
+		var r3: Rect2 = pd.rect
+		var col2: Color = pd.color
+		if id == "park":
+			for t: Vector2 in trees:
+				c.draw_circle(t + Vector2(4, 5), 20.0, Color(0, 0, 0, 0.3))
+				c.draw_circle(t, 20.0, Color("2f6b2a"))
+				c.draw_circle(t + Vector2(-5, -5), 11.0, Color("3f8a37"))
+			c.draw_string(f, r3.position + Vector2(0, r3.size.y * 0.5), String(pd.label), HORIZONTAL_ALIGNMENT_CENTER, r3.size.x, 22, Color(1, 1, 1, 0.8))
+			continue
+		c.draw_rect(Rect2(r3.position + Vector2(6, 8), r3.size - Vector2(6, 6)), Color(0, 0, 0, 0.4))
+		c.draw_rect(r3.grow(-3), Color("3b3f48") if id != "home" else Color("5a4a3a"))
+		c.draw_rect(r3.grow(-12), col2.darkened(0.45))
+		c.draw_rect(Rect2(r3.position.x + 3, r3.end.y - 26, r3.size.x - 6, 22), col2)
+		c.draw_string(f, Vector2(r3.position.x, r3.end.y - 9), String(pd.label), HORIZONTAL_ALIGNMENT_CENTER, r3.size.x, 15, Color(0.05, 0.05, 0.07))
+		var door: Vector2 = pd.door
+		c.draw_rect(Rect2(door + Vector2(-14, -T * 0.5 - 2), Vector2(28, 8)), col2.lightened(0.3))
+	for id2: String in places:
+		var pk: Vector2 = places[id2].park
+		if id2 != "park":
+			c.draw_rect(Rect2(pk - Vector2(30, 18), Vector2(60, 36)), Color(1, 1, 1, 0.25), false, 2.0)
+	for l: Vector2 in lamps:
+		c.draw_circle(l, 5.0, Color("cfd8dc"))
+
+
+func _near_row(y: float) -> bool:
+	for r: int in ROWS:
+		if absf(y - r * T) < T * 1.2:
+			return true
+	return false
+
+
+func _near_col(x: float) -> bool:
+	for col: int in COLS:
+		if absf(x - col * T) < T * 1.2:
+			return true
+	return false
+
+
+func _draw() -> void:
+	var night := sim.slot >= 3
+	var evening := sim.slot == 2
+	if gps.size() > 1:
+		draw_polyline(gps, Color(0.3, 0.85, 1.6, 0.55), 6.0)
+	for p: Dictionary in peds:
+		var pp: Vector2 = p.pos
+		draw_circle(pp + Vector2(1.5, 2), 6.0, Color(0, 0, 0, 0.3))
+		draw_circle(pp, 6.0, p.color)
+		draw_circle(pp, 3.5, Color(0.15, 0.12, 0.1))
+	for c: Dictionary in traffic:
+		_draw_car_shape(c.pos, Vector2(c.dir).angle(), c.color, bool(c.police), night or evening)
+	if has_car:
+		_draw_player_car(night or evening)
+	if not in_car:
+		_draw_walker()
+	if waypoint != "" and places.has(waypoint):
+		var door: Vector2 = places[waypoint].door
+		var pulse := 0.5 + 0.5 * sin(Time.get_ticks_msec() / 200.0)
+		draw_arc(door, 30.0 + pulse * 8.0, 0.0, TAU, 32, Color(0.3, 0.85, 1.6, 0.9), 3.0)
+
+
+func _draw_car_shape(at: Vector2, ang: float, col: Color, police: bool, lights: bool) -> void:
+	draw_set_transform(at, ang)
+	draw_rect(Rect2(-20, -10, 40, 20).grow(1.5), Color(0, 0, 0, 0.35))
+	draw_rect(Rect2(-20, -10, 40, 20), col)
+	draw_rect(Rect2(-6, -8, 16, 16), col.darkened(0.35))
+	draw_rect(Rect2(8, -8, 5, 16), Color(0.55, 0.75, 0.9, 0.9))
+	if lights:
+		draw_rect(Rect2(18, -9, 3, 5), Color(1, 0.97, 0.8))
+		draw_rect(Rect2(18, 4, 3, 5), Color(1, 0.97, 0.8))
+		draw_rect(Rect2(-21, -9, 2, 5), Color(0.9, 0.1, 0.1))
+		draw_rect(Rect2(-21, 4, 2, 5), Color(0.9, 0.1, 0.1))
+	if police:
+		draw_rect(Rect2(-20, -10, 40, 20), Color.WHITE, false, 2.0)
+		var blink := int(Time.get_ticks_msec() / 250) % 2 == 0
+		draw_rect(Rect2(-4, -9, 4, 8), Color(1.8, 0.2, 0.2) if blink else Color(0.3, 0.3, 1.8))
+		draw_rect(Rect2(-4, 1, 4, 8), Color(0.3, 0.3, 1.8) if blink else Color(1.8, 0.2, 0.2))
+	draw_set_transform(Vector2.ZERO, 0.0)
+
+
+func _draw_player_car(lights: bool) -> void:
+	if car_tex != null:
+		# Garage renders point up: rotate so the nose faces car_ang.
+		var s := 46.0 / maxf(car_tex.get_size().y, 1.0)
+		draw_set_transform_matrix(Transform2D(car_ang + PI * 0.5, Vector2(s, s), 0.0, car_pos + Vector2(3, 4)))
+		draw_texture(car_tex, -car_tex.get_size() * 0.5, Color(0, 0, 0, 0.35))
+		draw_set_transform_matrix(Transform2D(car_ang + PI * 0.5, Vector2(s, s), 0.0, car_pos))
+		draw_texture(car_tex, -car_tex.get_size() * 0.5)
+		draw_set_transform_matrix(Transform2D.IDENTITY)
+	else:
+		_draw_car_shape(car_pos, car_ang, Color("ff7f2e"), false, lights and in_car)
+	if not in_car:
+		draw_string(ThemeDB.fallback_font, car_pos + Vector2(-40, -26), "Your car", HORIZONTAL_ALIGNMENT_CENTER, 80, 10, Color(1, 1, 1, 0.7))
+
+
+func _draw_walker() -> void:
+	var bob := sin(walk_t * 14.0) * 1.2
+	draw_circle(foot_pos + Vector2(1.5, 2.5), 9.0, Color(0, 0, 0, 0.35))
+	draw_circle(foot_pos, 9.0, Color("ff7f2e"))
+	draw_circle(foot_pos + face * (4.0 + bob), 5.0, Color("f2d2b6"))
+
+
+func draw_minimap(m: Control) -> void:
+	var sz := m.size
+	var sc := minf(sz.x / (MW * T), sz.y / (MH * T))
+	m.draw_rect(Rect2(Vector2.ZERO, sz), Color(0.05, 0.06, 0.08, 0.85))
+	for y in MH:
+		for x in MW:
+			var t := tile(Vector2i(x, y))
+			var col := Color(0, 0, 0, 0)
+			match t:
+				ROAD:
+					col = Color("6b6e75")
+				GRASS:
+					col = Color("3f7a33")
+				WATER:
+					col = Color("1f5f8b")
+				LOT:
+					col = Color("44474f")
+			if col.a > 0.0:
+				m.draw_rect(Rect2(Vector2(x, y) * T * sc, Vector2(T, T) * sc + Vector2(0.5, 0.5)), col)
+	if gps.size() > 1:
+		var pts := PackedVector2Array()
+		for p in gps:
+			pts.append(p * sc)
+		m.draw_polyline(pts, Color(0.3, 0.85, 1.0), 2.0)
+	var f := ThemeDB.fallback_font
+	for id: String in places:
+		var pd: Dictionary = places[id]
+		var at: Vector2 = (pd.rect as Rect2).get_center() * sc
+		m.draw_circle(at, 5.0, pd.color)
+		if id == waypoint:
+			m.draw_arc(at, 8.0, 0.0, TAU, 16, Color.WHITE, 1.5)
+		m.draw_string(f, at + Vector2(-2.5, 3.5), String(pd.label).substr(0, 1), HORIZONTAL_ALIGNMENT_LEFT, -1, 8, Color(0, 0, 0))
+	var me := _me() * sc
+	var ang := car_ang if in_car else face.angle()
+	var tri := PackedVector2Array([me + Vector2.from_angle(ang) * 7.0, me + Vector2.from_angle(ang + 2.5) * 5.0, me + Vector2.from_angle(ang - 2.5) * 5.0])
+	m.draw_colored_polygon(tri, Color.WHITE)
+	if has_car and not in_car:
+		m.draw_rect(Rect2(car_pos * sc - Vector2(2, 2), Vector2(4, 4)), Color("ff7f2e"))
+	for c: Dictionary in traffic:
+		if bool(c.police):
+			m.draw_circle((c.pos as Vector2) * sc, 2.0, Color(0.4, 0.5, 1.0))
+	m.draw_rect(Rect2(Vector2.ZERO, sz), UI.BORDER, false, 1.0)
+
