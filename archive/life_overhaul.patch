+++ b/scripts/city/city.gd
@@ -0,0 +1,1263 @@
+class_name City
+extends Node2D
+## My Player: the city. A compact top-down district: drive your car (or walk,
+## or take a taxi) between your home, the bar, the club, the gym, the diner,
+## the corner shop, the training ground, the arena, the car dealer and the
+## park. Traffic, police (drink driving gets you arrested), a minimap with
+## GPS, day/night lighting from the life clock. Walk up to a door and press E.
+
+const T := 64.0 ## Tile size (px).
+const MW := 48
+const MH := 32
+const COLS := [4, 14, 24, 34, 44] ## Vertical roads: tiles c-1 and c (centre line at x = c * T).
+const ROWS := [4, 12, 20, 28] ## Horizontal roads.
+enum { GRASS, ROAD, WALKWAY, BUILDING, LOT, WATER }
+const SOLID := [BUILDING, WATER]
+
+const FOOT_SPEED := 130.0
+const FOOT_RUN := 210.0
+const FOOT_R := 9.0
+const CAR_R := 17.0
+const CAR_STATS := {"car_hatchback": {"top": 300.0, "acc": 240.0}, "car": {"top": 430.0, "acc": 330.0},
+	"car_suv": {"top": 360.0, "acc": 270.0}, "car_super": {"top": 540.0, "acc": 420.0}}
+const TRAFFIC := 14
+const POLICE := 2
+
+## Places: block (bx, by) between roads, the sign colour, and what E does.
+const PLACES := {
+	"home": {"block": [0, 0], "color": Color("6fae5c"), "label": "Home"},
+	"shop": {"block": [1, 0], "color": Color("3fa9a0"), "label": "24/7 Corner Shop"},
+	"gym": {"block": [2, 0], "color": Color("d9534f"), "label": "Iron Works Gym"},
+	"training": {"block": [3, 0], "color": Color("ff7f2e"), "label": "Training ground"},
+	"diner": {"block": [0, 1], "color": Color("e8b04a"), "label": "Corner Diner"},
+	"park": {"block": [1, 1], "color": Color("4caf50"), "label": "City park"},
+	"bar": {"block": [2, 1], "color": Color("9b59b6"), "label": "The Neon Tap"},
+	"dealer": {"block": [3, 1], "color": Color("38d0ff"), "label": "Prestige Motors"},
+	"club": {"block": [0, 2], "color": Color("e84393"), "label": "Pulse"},
+	"arena": {"block": [1, 2], "color": Color("f1c40f"), "label": "Lockdown Arena"},
+}
+const LOT_BLOCK := [2, 2]
+
+var w: World
+var life: Lifestyle
+var sim: LifeSim
+var tiles := PackedByteArray()
+var places := {} ## id -> {door: Vector2 (px), park: Vector2, rect: Rect2, color, label}
+var blocks_art: Array = [] ## Generic buildings: {rect, color}
+var trees: Array = [] ## Vector2
+var lamps: Array = [] ## Vector2
+
+var in_car := false
+var car_id := "" ## Shop id of the car you drive ("" = none).
+var car_pos := Vector2.ZERO
+var car_ang := 0.0
+var car_speed := 0.0
+var car_tex: Texture2D = null
+var has_car := false
+var foot_pos := Vector2.ZERO
+var face := Vector2.DOWN
+var walk_t := 0.0
+
+var traffic: Array = [] ## {pos, dir: Vector2i, speed, want, node: Vector2i, police, color, stop}
+var peds: Array = [] ## {pos, dir, speed, min, max, axis, color}
+var waypoint := "" ## GPS target place id.
+var gps: PackedVector2Array = PackedVector2Array()
+var _gps_t := 0.0
+var _police_cd := 0.0
+var _ticket_cd := 0.0
+var _crash_cd := 0.0
+var frozen := false
+
+var cam: Camera2D
+var map_layer: Node2D
+var modulate_node: CanvasModulate
+var ui: Control
+var hud_place: Label
+var hud_time: Label
+var hud_stats: Label
+var hud_needs: HBoxContainer
+var hud_tags: HFlowContainer
+var prompt: Label
+var toast: Label
+var toast_t := 0.0
+var speedo: Label
+var minimap: Control
+var modal: Control = null
+var target := "" ## Place id E would use.
+var lamp_lights: Array[PointLight2D] = [] ## Pool, moved to the lamps nearest the camera.
+var car_lights: Array[PointLight2D] = [] ## Pool for traffic headlights.
+var head_light: PointLight2D
+var _light_t := 0.0
+var rng := RandomNumberGenerator.new()
+
+
+class MapLayer extends Node2D:
+	var city: City
+	func _draw() -> void:
+		city.draw_map(self)
+
+
+class MiniMapView extends Control:
+	var city: City
+	func _draw() -> void:
+		city.draw_minimap(self)
+
+
+func _ready() -> void:
+	w = Game.pworld
+	if w == null or w.user_player == null:
+		Game.goto(Game.MENU_SCENE)
+		return
+	life = w.life()
+	sim = life.sim
+	sim.sync()
+	sim.location = "city"
+	rng.seed = 7741
+	_build_map()
+	map_layer = MapLayer.new()
+	map_layer.city = self
+	map_layer.z_index = -10
+	add_child(map_layer)
+	modulate_node = CanvasModulate.new()
+	add_child(modulate_node)
+	_apply_light()
+	_make_lights()
+	var cars := life.cars()
+	has_car = not cars.is_empty()
+	if has_car:
+		car_id = String(cars[0])
+		var sp := String(Lifestyle.info(car_id).get("sprite", ""))
+		var tp: String = Home.ART_DIR + "props/" + sp + ".png"
+		car_tex = load(tp) if ResourceLoader.exists(tp) else null
+	var spawn := Game.city_spawn if places.has(Game.city_spawn) else "home"
+	foot_pos = places[spawn].door
+	var park_at := sim.car_at if places.has(sim.car_at) else "home"
+	car_pos = places[park_at].park
+	car_ang = 0.0
+	in_car = has_car and not Game.city_on_foot and park_at == spawn and sim.can_drive()
+	if in_car:
+		car_pos = places[spawn].park
+	_spawn_traffic()
+	_spawn_peds()
+	cam = Camera2D.new()
+	cam.position_smoothing_enabled = true
+	cam.position_smoothing_speed = 6.0
+	cam.ignore_rotation = false
+	add_child(cam)
+	cam.make_current()
+	_fit_zoom()
+	get_viewport().size_changed.connect(_fit_zoom)
+	cam.global_position = _me()
+	cam.reset_smoothing()
+	_build_ui()
+	_refresh_hud()
+	if Game.pending_toast != "":
+		_say(Game.pending_toast, 6.0)
+		Game.pending_toast = ""
+	elif in_car:
+		_say("WASD drive, Space handbrake, F get out, E at a door, M for the map.", 6.0)
+	else:
+		_say("WASD walk (Shift runs), F get in your car, E at a door, M for the map." if has_car else "WASD walk (Shift runs), E at a door, M for the map. No car: call a taxi from your phone (P).", 6.0)
+
+
+func _fit_zoom() -> void:
+	var vh := get_viewport_rect().size.y
+	var z := clampf(vh / 900.0, 0.6, 1.6) * (0.85 if in_car else 1.25)
+	cam.zoom = Vector2(z, z)
+
+
+func _me() -> Vector2:
+	return car_pos if in_car else foot_pos
+
+
+# --- Map -------------------------------------------------------------------------
+
+func tile(c: Vector2i) -> int:
+	if c.x < 0 or c.y < 0 or c.x >= MW or c.y >= MH:
+		return BUILDING
+	return tiles[c.y * MW + c.x]
+
+
+func _set_tile(x: int, y: int, v: int) -> void:
+	if x >= 0 and y >= 0 and x < MW and y < MH:
+		tiles[y * MW + x] = v
+
+
+func tile_at(p: Vector2) -> int:
+	return tile(Vector2i(floori(p.x / T), floori(p.y / T)))
+
+
+## Block bx between COLS[bx] and COLS[bx+1]; by between ROWS[by] and ROWS[by+1]. In tiles.
+func block_rect(bx: int, by: int) -> Rect2i:
+	var x0: int = COLS[bx] + 2
+	var x1: int = COLS[bx + 1] - 3
+	var y0: int = ROWS[by] + 2
+	var y1: int = ROWS[by + 1] - 3
+	return Rect2i(x0, y0, x1 - x0 + 1, y1 - y0 + 1)
+
+
+func _build_map() -> void:
+	tiles.resize(MW * MH)
+	tiles.fill(BUILDING)
+	for y in range(MH - 2, MH):
+		for x in MW:
+			_set_tile(x, y, WATER)
+	for c: int in COLS:
+		for y in range(0, MH - 2):
+			for x in [c - 2, c + 1]:
+				if tile(Vector2i(x, y)) == BUILDING:
+					_set_tile(x, y, WALKWAY)
+	for r: int in ROWS:
+		for x in MW:
+			for y in [r - 2, r + 1]:
+				if y < MH - 2 and tile(Vector2i(x, y)) == BUILDING:
+					_set_tile(x, y, WALKWAY)
+	for c: int in COLS:
+		for y in range(0, MH - 2):
+			_set_tile(c - 1, y, ROAD)
+			_set_tile(c, y, ROAD)
+	for r: int in ROWS:
+		for x in MW:
+			_set_tile(x, r - 1, ROAD)
+			_set_tile(x, r, ROAD)
+	# Places.
+	for id: String in PLACES:
+		var d: Dictionary = PLACES[id]
+		var b := block_rect(int(d.block[0]), int(d.block[1]))
+		var rect := Rect2(Vector2(b.position) * T, Vector2(b.size) * T)
+		if id == "park":
+			for y in range(b.position.y, b.end.y):
+				for x in range(b.position.x, b.end.x):
+					_set_tile(x, y, GRASS)
+			for i in 14:
+				trees.append(rect.position + Vector2(rng.randf_range(20, rect.size.x - 20), rng.randf_range(20, rect.size.y - 20)))
+		var door_t := Vector2i(b.position.x + b.size.x / 2, b.end.y) # Walkway below the block.
+		places[id] = {"door": (Vector2(door_t) + Vector2(0.5, 0.5)) * T, "park": Vector2((door_t.x + 0.5) * T, (door_t.y + 1.5) * T + 10.0),
+			"rect": rect, "color": d.color, "label": d.label if id != "home" else String(Lifestyle.info(life.home).get("name", "Home"))}
+	var lb := block_rect(int(LOT_BLOCK[0]), int(LOT_BLOCK[1]))
+	for y in range(lb.position.y, lb.end.y):
+		for x in range(lb.position.x, lb.end.x):
+			_set_tile(x, y, LOT)
+	# Generic buildings: split each remaining solid run into a few shapes.
+	var palette := [Color("5b6170"), Color("6d6a75"), Color("7a6e62"), Color("4f5d6b"), Color("665a6e"), Color("5e6b5a"), Color("806f5d")]
+	for by in range(-1, ROWS.size()):
+		for bx in range(-1, COLS.size()):
+			var x0: int = 0 if bx < 0 else int(COLS[bx]) + 2
+			var x1: int = MW - 1 if bx >= COLS.size() - 1 else int(COLS[bx + 1]) - 3
+			var y0: int = 0 if by < 0 else int(ROWS[by]) + 2
+			var y1: int = MH - 3 if by >= ROWS.size() - 1 else int(ROWS[by + 1]) - 3
+			if x1 < x0 or y1 < y0:
+				continue
+			var taken := false
+			for id: String in places:
+				if (places[id].rect as Rect2).has_point(Vector2(x0 + 0.5, y0 + 0.5) * T):
+					taken = true
+			if taken or (bx == int(LOT_BLOCK[0]) and by == int(LOT_BLOCK[1])):
+				continue
+			var x := x0
+			while x <= x1:
+				var wdt := mini(rng.randi_range(2, 4), x1 - x + 1)
+				blocks_art.append({"rect": Rect2(Vector2(x, y0) * T + Vector2(3, 3), Vector2(wdt, y1 - y0 + 1) * T - Vector2(6, 6)),
+					"color": palette[rng.randi() % palette.size()]})
+				x += wdt
+	for c: int in COLS:
+		for r: int in ROWS:
+			lamps.append(Vector2((c + 1.5) * T, (r - 1.5) * T))
+			lamps.append(Vector2((c - 1.5) * T, (r + 1.5) * T))
+
+
+func solid_at(p: Vector2, r: float) -> bool:
+	var x0 := floori((p.x - r) / T)
+	var x1 := floori((p.x + r) / T)
+	var y0 := floori((p.y - r) / T)
+	var y1 := floori((p.y + r) / T)
+	for cy in range(y0, y1 + 1):
+		for cx in range(x0, x1 + 1):
+			if tile(Vector2i(cx, cy)) in SOLID:
+				var rr := Rect2(cx * T, cy * T, T, T)
+				var q := Vector2(clampf(p.x, rr.position.x, rr.end.x), clampf(p.y, rr.position.y, rr.end.y))
+				if q.distance_to(p) < r:
+					return true
+	return false
+
+
+# --- Traffic & people ------------------------------------------------------------
+
+func _node_pos(n: Vector2i) -> Vector2:
+	return Vector2(COLS[n.x] * T, ROWS[n.y] * T)
+
+
+func _spawn_traffic() -> void:
+	var colors := [Color("c0392b"), Color("2980b9"), Color("ecf0f1"), Color("2c3e50"), Color("f39c12"), Color("16a085"), Color("8e44ad"), Color("7f8c8d")]
+	for i in TRAFFIC:
+		var n := Vector2i(rng.randi() % COLS.size(), rng.randi() % ROWS.size())
+		var dirs := _exits(n)
+		var d: Vector2i = dirs[rng.randi() % dirs.size()]
+		var start := _node_pos(n).lerp(_node_pos(n + d), rng.randf_range(0.2, 0.8)) + _lane(d)
+		traffic.append({"pos": start, "dir": d, "speed": 0.0, "want": rng.randf_range(120.0, 170.0), "node": n + d,
+			"police": i < POLICE, "color": Color("1b2a4a") if i < POLICE else colors[rng.randi() % colors.size()], "stop": 0.0})
+
+
+func _exits(n: Vector2i) -> Array:
+	var out: Array = []
+	for d: Vector2i in [Vector2i(1, 0), Vector2i(-1, 0), Vector2i(0, 1), Vector2i(0, -1)]:
+		var m := n + d
+		if m.x >= 0 and m.y >= 0 and m.x < COLS.size() and m.y < ROWS.size():
+			out.append(d)
+	return out
+
+
+## Drive on the right: lane centre offset for heading d.
+func _lane(d: Vector2i) -> Vector2:
+	return Vector2(-d.y, d.x) * 32.0
+
+
+func _traffic_tick(delta: float) -> void:
+	var me := _me()
+	for c: Dictionary in traffic:
+		var d: Vector2i = c.dir
+		var dv := Vector2(d)
+		var goal := _node_pos(c.node) + _lane(d)
+		# Something in front: slow down / stop.
+		var blocked := false
+		var ahead := 70.0
+		for ob: Vector2 in ([me, car_pos] if has_car else [me]):
+			var rel := ob - (c.pos as Vector2)
+			if rel.dot(dv) > 0.0 and rel.length() < ahead and absf(rel.cross(dv)) < 26.0:
+				blocked = true
+		for o: Dictionary in traffic:
+			if o == c:
+				continue
+			var to: Vector2 = (o.pos as Vector2) - (c.pos as Vector2)
+			if to.dot(dv) > 0.0 and to.length() < 60.0 and absf(to.cross(dv)) < 22.0:
+				blocked = true
+		var want := 0.0 if blocked else float(c.want)
+		c.speed = move_toward(float(c.speed), want, delta * (300.0 if want < float(c.speed) else 120.0))
+		var to_goal := goal - (c.pos as Vector2)
+		var step := float(c.speed) * delta
+		if to_goal.dot(dv) <= step:
+			# At the junction: pick a way on (no U-turns unless stuck).
+			var n: Vector2i = c.node
+			var opts := _exits(n).filter(func(e: Vector2i) -> bool: return e != -d)
+			if opts.is_empty():
+				opts = [-d]
+			var nd: Vector2i = opts[rng.randi() % opts.size()]
+			c.pos = _node_pos(n) + _lane(nd)
+			c.dir = nd
+			c.node = n + nd
+		else:
+			c.pos = (c.pos as Vector2) + dv * step
+
+
+func _spawn_peds() -> void:
+	var cols := [Color("e0c3a0"), Color("8d5b3e"), Color("f2d2b6"), Color("6b4430"), Color("c99a76")]
+	for i in 22:
+		var vertical := rng.randf() < 0.5
+		var pos := Vector2.ZERO
+		var lo := 0.0
+		var hi := 0.0
+		if vertical:
+			var c: int = COLS[rng.randi() % COLS.size()]
+			var x := (c - 1.5 if rng.randf() < 0.5 else c + 1.5) * T
+			lo = T * 1.0
+			hi = (MH - 3) * T
+			pos = Vector2(x, rng.randf_range(lo, hi))
+		else:
+			var r: int = ROWS[rng.randi() % ROWS.size()]
+			var y := (r - 1.5 if rng.randf() < 0.5 else r + 1.5) * T
+			lo = T * 1.0
+			hi = (MW - 1) * T
+			pos = Vector2(rng.randf_range(lo, hi), y)
+		peds.append({"pos": pos, "dir": 1.0 if rng.randf() < 0.5 else -1.0, "speed": rng.randf_range(35.0, 60.0), "lo": lo, "hi": hi,
+			"vertical": vertical, "color": cols[rng.randi() % cols.size()]})
+
+
+func _peds_tick(delta: float) -> void:
+	var me := _me()
+	for p: Dictionary in peds:
+		var axis := Vector2(0, 1) if bool(p.vertical) else Vector2(1, 0)
+		var pos: Vector2 = p.pos
+		pos += axis * float(p.dir) * float(p.speed) * delta
+		var along := pos.y if bool(p.vertical) else pos.x
+		if along < float(p.lo) or along > float(p.hi):
+			p.dir = -float(p.dir)
+		# Step out of the way of you (and your car).
+		var away := pos - me
+		var keep := (CAR_R + 16.0) if in_car else 16.0
+		if away.length() < keep:
+			pos = me + away.normalized() * keep
+		p.pos = pos
+
+
+# --- Frame ------------------------------------------------------------------------
+
+func _process(delta: float) -> void:
+	var busy := frozen or (modal != null and is_instance_valid(modal))
+	if in_car:
+		_drive_tick(delta, busy)
+	else:
+		_walk_tick(delta, busy)
+	_traffic_tick(delta)
+	_peds_tick(delta)
+	_police_tick(delta)
+	var me := _me()
+	cam.global_position = me + (Vector2.from_angle(car_ang) * car_speed * 0.35 if in_car else Vector2.ZERO)
+	var wob := sim.wobble()
+	if wob > 0.05:
+		var tt := Time.get_ticks_msec() / 1000.0
+		cam.offset = Vector2(sin(tt * 1.1), cos(tt * 0.8)) * 26.0 * wob
+		cam.rotation = sin(tt * 0.6) * 0.07 * wob
+	else:
+		cam.offset = Vector2.ZERO
+		cam.rotation = 0.0
+	target = "" if busy else _near_place()
+	prompt.visible = target != ""
+	if target != "":
+		prompt.text = "E   %s" % _place_action(target)
+	_gps_t -= delta
+	if _gps_t <= 0.0:
+		_gps_t = 0.5
+		_update_gps()
+	if toast_t > 0.0:
+		toast_t -= delta
+		toast.modulate.a = clampf(toast_t / 0.6, 0.0, 1.0)
+	speedo.visible = in_car
+	if in_car:
+		speedo.text = "%d km/h" % int(absf(car_speed) * 0.25)
+	_crash_cd = maxf(0.0, _crash_cd - delta)
+	_lights_tick(delta)
+	if sim.location == "home" and not frozen:
+		# Blacked out on the street: you wake up at home.
+		Game.pending_toast = toast.text
+		Game.venue = ""
+		Game.goto(Game.HOME_SCENE)
+		return
+	queue_redraw()
+	minimap.queue_redraw()
+
+
+func _walk_tick(delta: float, busy: bool) -> void:
+	var v := Vector2.ZERO
+	if not busy:
+		v = Input.get_vector("move_left", "move_right", "move_up", "move_down")
+	var wob := sim.wobble()
+	if wob > 0.05 and v.length() > 0.05:
+		var tt := Time.get_ticks_msec() / 1000.0
+		v = (v + Vector2(sin(tt * 1.7), cos(tt * 1.3)) * 0.5 * wob).limit_length(1.0)
+	if v.length() > 0.05:
+		face = face.lerp(v.normalized(), minf(1.0, delta * 12.0)).normalized()
+		var sp := FOOT_RUN if Input.is_action_pressed("walk") else FOOT_SPEED
+		var step := v * sp * delta
+		var nx := foot_pos + Vector2(step.x, 0.0)
+		if not solid_at(nx, FOOT_R):
+			foot_pos = nx
+		var ny := foot_pos + Vector2(0.0, step.y)
+		if not solid_at(ny, FOOT_R):
+			foot_pos = ny
+		walk_t += delta
+	foot_pos = foot_pos.clamp(Vector2(FOOT_R, FOOT_R), Vector2(MW * T - FOOT_R, MH * T - FOOT_R))
+
+
+func _car_stats() -> Dictionary:
+	return CAR_STATS.get(car_id, CAR_STATS.car_hatchback)
+
+
+func _drive_tick(delta: float, busy: bool) -> void:
+	var st := _car_stats()
+	var thr := 0.0
+	var steer := 0.0
+	var brake := false
+	if not busy:
+		thr = Input.get_axis("move_down", "move_up")
+		steer = Input.get_axis("move_left", "move_right")
+		brake = Input.is_key_pressed(KEY_SPACE)
+	var top := float(st.top) * (0.55 if tile_at(car_pos) != ROAD else 1.0)
+	if thr > 0.0:
+		car_speed = minf(top, car_speed + float(st.acc) * thr * delta) if car_speed >= 0.0 else car_speed + 600.0 * delta
+	elif thr < 0.0:
+		car_speed = maxf(-130.0, car_speed - (520.0 if car_speed > 0.0 else 200.0) * -thr * delta)
+	else:
+		car_speed = move_toward(car_speed, 0.0, 140.0 * delta)
+	if car_speed > top:
+		car_speed = move_toward(car_speed, top, 400.0 * delta)
+	if brake:
+		car_speed = move_toward(car_speed, 0.0, 700.0 * delta)
+	var grip := clampf(absf(car_speed) / 160.0, 0.0, 1.0)
+	var turn := steer * 2.7 * grip * signf(car_speed) * (1.6 if brake else 1.0)
+	var wob := sim.wobble()
+	if wob > 0.05:
+		var tt := Time.get_ticks_msec() / 1000.0
+		turn += sin(tt * 1.3) * 0.9 * wob * grip
+	car_ang += turn * delta
+	var vel := Vector2.from_angle(car_ang) * car_speed
+	var next := car_pos + vel * delta
+	var hit_speed := 0.0
+	if solid_at(next, CAR_R) or next.x < CAR_R or next.y < CAR_R or next.x > MW * T - CAR_R or next.y > MH * T - CAR_R:
+		hit_speed = absf(car_speed)
+		car_speed *= -0.25
+	else:
+		car_pos = next
+	for c: Dictionary in traffic:
+		var to: Vector2 = car_pos - (c.pos as Vector2)
+		if to.length() < CAR_R * 2.0:
+			car_pos = (c.pos as Vector2) + to.normalized() * CAR_R * 2.0
+			hit_speed = maxf(hit_speed, absf(car_speed))
+			car_speed *= -0.3
+			if bool(c.police) and hit_speed > 120.0:
+				_pulled_over("hitting a police car" + (" while %s" % _impaired_text() if sim.impaired() else ""), true)
+				return
+	if hit_speed > 200.0 and _crash_cd <= 0.0:
+		_crash(hit_speed)
+
+
+func _crash(speed: float) -> void:
+	_crash_cd = 1.5
+	var bill := int(speed * 3.0)
+	if car_id == "car_super":
+		bill *= 3
+	bill = mini(bill, w.wallet)
+	w.wallet -= bill
+	var t := "Crash! Repairs: $%s." % World._fmt(bill)
+	var me := w.user_player
+	if speed > 330.0 and rng.randf() < 0.18 and me.out_weeks == 0:
+		me.out_weeks = rng.randi_range(1, 2)
+		me.ailment = "a car crash"
+		w._news("INJURY: you crashed your car and will miss %d week%s." % [me.out_weeks, "s" if me.out_weeks > 1 else ""])
+		t += " You're hurt: out for %d week%s." % [me.out_weeks, "s" if me.out_weeks > 1 else ""]
+	if speed > 280.0 and rng.randf() < 0.25 + float(w.fame) / 1000000.0:
+		w._post(w._fan_handle(), "just watched %s crash his %s downtown lmao is he ok" % [me.player_name, String(Lifestyle.info(car_id).get("name", "car")).to_lower()], "fan", 1.4)
+	_say(t, 4.0)
+	Game.save_player_career_soon()
+
+
+func _impaired_text() -> String:
+	if sim.drunk >= 25.0:
+		return "drunk"
+	return "high"
+
+
+## Police near you: drink/drug driving gets you pulled over; speeding gets a ticket.
+func _police_tick(delta: float) -> void:
+	_police_cd = maxf(0.0, _police_cd - delta)
+	_ticket_cd = maxf(0.0, _ticket_cd - delta)
+	if not in_car or frozen or _police_cd > 0.0:
+		return
+	for c: Dictionary in traffic:
+		if not bool(c.police):
+			continue
+		var d := (c.pos as Vector2).distance_to(car_pos)
+		if d > 260.0:
+			continue
+		if sim.impaired():
+			var swerving := absf(car_speed) > 120.0
+			var p := (0.9 if d < 130.0 else 0.4) * (1.3 if swerving else 0.7)
+			_police_cd = 1.0
+			if rng.randf() < p:
+				_pulled_over("%s driving" % _impaired_text(), false)
+			return
+		if absf(car_speed) > float(_car_stats().top) * 0.8 and _ticket_cd <= 0.0:
+			_ticket_cd = 20.0
+			var fine := mini(w.wallet, 300)
+			w.wallet -= fine
+			_say("Flashing lights: speeding ticket, $%d." % fine)
+			return
+
+
+func _pulled_over(what: String, rammed: bool) -> void:
+	frozen = true
+	car_speed = 0.0
+	var t := ""
+	if sim.impaired() or rammed:
+		t = sim.dui(what)
+		sim.car_at = "home" # Towed.
+		in_car = false
+		foot_pos = car_pos + Vector2(0, 40)
+		has_car = has_car and sim.can_drive()
+		if rammed and not sim.impaired():
+			var fine := mini(w.wallet, 2000)
+			w.wallet -= fine
+	var box := _open(520, "Pulled over")
+	var l := UI.label(t, 14, UI.TEXT)
+	l.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
+	box.add_child(l)
+	box.add_child(UI.label("Your car has been towed home. You're on foot.", 12, UI.WARN))
+	Game.save_player_career_soon()
+
+
+func _near_place() -> String:
+	var me := _me()
+	for id: String in places:
+		var d: Vector2 = places[id].door
+		var r := 90.0 if in_car else 46.0
+		if me.distance_to(d) < r or (in_car and me.distance_to(places[id].park) < 70.0):
+			return id
+	return ""
+
+
+func _place_action(id: String) -> String:
+	var lbl := String(places[id].label)
+	match id:
+		"home":
+			return "Go inside (%s)" % lbl
+		"arena":
+			return "Play your match at %s" % lbl if sim.is_match_time() else "Go into %s" % lbl
+		"dealer":
+			return "Browse cars at %s" % lbl
+		"park":
+			return "Hang out in the park"
+	if not Venues.is_open(id, sim.slot):
+		return "%s (closed: %s)" % [lbl, Venues.hours_text(id).to_lower()]
+	return "Go into %s" % lbl
+
+
+# --- Input -------------------------------------------------------------------------
+
+func _unhandled_input(event: InputEvent) -> void:
+	if event.is_action_pressed("quit"):
+		get_viewport().set_input_as_handled()
+		if modal != null and is_instance_valid(modal):
+			_close()
+		else:
+			_pause_menu()
+		return
+	if modal != null and is_instance_valid(modal):
+		return
+	if not (event is InputEventKey and event.pressed and not event.echo):
+		if event.is_action_pressed("use") and target != "":
+			_enter(target)
+		return
+	var k := (event as InputEventKey).physical_keycode
+	if event.is_action_pressed("use") and target != "":
+		get_viewport().set_input_as_handled()
+		_enter(target)
+	elif k == KEY_F:
+		get_viewport().set_input_as_handled()
+		_toggle_car()
+	elif k == KEY_M:
+		get_viewport().set_input_as_handled()
+		_map_panel()
+	elif k == KEY_P:
+		get_viewport().set_input_as_handled()
+		_phone()
+
+
+func _toggle_car() -> void:
+	if in_car:
+		if absf(car_speed) > 60.0:
+			_say("Slow down first.")
+			return
+		in_car = false
+		car_speed = 0.0
+		foot_pos = car_pos + Vector2.from_angle(car_ang + PI * 0.5) * 34.0
+		if solid_at(foot_pos, FOOT_R):
+			foot_pos = car_pos + Vector2.from_angle(car_ang - PI * 0.5) * 34.0
+		sim.car_at = _closest_place(car_pos)
+		_fit_zoom()
+		return
+	if not has_car:
+		_say("You don't have a car. Call a taxi from your phone (P).")
+		return
+	if not sim.can_drive():
+		_say("Your licence is suspended.")
+		return
+	if foot_pos.distance_to(car_pos) > 60.0:
+		_say("Your car is parked at %s." % String(places[sim.car_at].label) if places.has(sim.car_at) else "Your car isn't here.")
+		return
+	in_car = true
+	_fit_zoom()
+	if sim.impaired():
+		_say("You really shouldn't be driving like this.", 3.0)
+
+
+func _closest_place(p: Vector2) -> String:
+	var best := "home"
+	var bd := 1e12
+	for id: String in places:
+		var d := p.distance_to(places[id].park)
+		if d < bd:
+			bd = d
+			best = id
+	return best
+
+
+func _enter(id: String) -> void:
+	if in_car:
+		if absf(car_speed) > 80.0:
+			_say("Stop the car first.")
+			return
+		sim.car_at = id
+		car_pos = places[id].park
+	else:
+		sim.car_at = sim.car_at if places.has(sim.car_at) else "home"
+	match id:
+		"home":
+			Game.venue = ""
+			sim.location = "home"
+			_go(Game.HOME_SCENE)
+		"dealer":
+			Game.hub_page = "Shop"
+			_go(Game.CAREER_SCENE)
+		"park":
+			_park_panel()
+		"arena":
+			if sim.is_match_time() and Game.prepare_player_match():
+				_go(Game.MATCH_SCENE)
+			else:
+				Game.venue = "arena"
+				sim.location = "arena"
+				_go(Game.HOME_SCENE)
+		_:
+			if not Venues.is_open(id, sim.slot):
+				_say("%s is closed. %s." % [String(places[id].label), Venues.hours_text(id)])
+				return
+			Game.venue = id
+			sim.location = id
+			_go(Game.HOME_SCENE)
+
+
+func _go(scene: String) -> void:
+	frozen = true
+	Game.home_tour = ""
+	Game.save_player_career_soon()
+	Game.goto(scene)
+
