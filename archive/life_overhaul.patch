+func _refresh_hud() -> void:
+	hud_time.text = "%s  -  %s" % [sim.time_text().capitalize(), sim.match_text()]
+	hud_stats.text = "Wallet %s    Morale %d%s" % [UI.money_text(w.wallet), int(w.user_player.morale), "" if sim.can_drive() else "    Licence suspended"]
+	LifeHud.needs_row(hud_needs, sim)
+	LifeHud.tags(hud_tags, sim)
+
+
+func _say(t: String, secs: float = 4.0) -> void:
+	toast.text = t
+	toast_t = secs
+	toast.modulate.a = 1.0
+	_refresh_hud()
+
+
+func _open(width: int, title: String) -> VBoxContainer:
+	if modal != null and is_instance_valid(modal):
+		modal.queue_free()
+	var m := UI.modal(ui, width, UI.ACCENT)
+	modal = m[0]
+	var box: VBoxContainer = m[1]
+	var head := UI.hbox(8)
+	head.add_child(UI.label(title, 20, UI.TEXT, 700))
+	head.add_child(UI.spacer())
+	head.add_child(UI.small_button("Close", _close, 80, "GhostButton"))
+	box.add_child(head)
+	return box
+
+
+func _close() -> void:
+	if modal != null and is_instance_valid(modal):
+		modal.queue_free()
+	modal = null
+	frozen = false
+	_refresh_hud()
+
+
+func _row(box: VBoxContainer, title: String, sub: String, btn: String, cb: Callable, disabled: bool = false) -> void:
+	var r := UI.hbox(10)
+	var v := UI.vbox(0)
+	v.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	v.add_child(UI.label(title, 14, UI.TEXT, 600))
+	if sub != "":
+		var l := UI.label(sub, 11, UI.TEXT_DIM)
+		l.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
+		v.add_child(l)
+	r.add_child(v)
+	var b := UI.small_button(btn, cb, 130, "PrimaryButton")
+	b.disabled = disabled
+	r.add_child(b)
+	box.add_child(r)
+
+
+func _map_panel() -> void:
+	var box := _open(560, "Map")
+	box.add_child(UI.label("Pick a place to set your GPS. It's %s." % sim.time_text(), 12, UI.TEXT_DIM))
+	for id: String in places:
+		var idd := id
+		var sub := ""
+		if Venues.IDS.has(id):
+			sub = Venues.hours_text(id) + ("" if Venues.is_open(id, sim.slot) else "  (closed now)")
+		elif id == "arena":
+			sub = sim.match_text()
+		_row(box, String(places[id].label), sub, "Go here" if waypoint != id else "Selected", func() -> void:
+			waypoint = idd
+			_update_gps()
+			_close())
+
+
+func _park_panel() -> void:
+	var box := _open(520, "City park")
+	_row(box, "Walk around", "Fresh air: fun +10, takes a slot.", "Walk", func() -> void:
+		sim.add_need("fun", 10.0)
+		sim.add_need("energy", -4.0)
+		sim.hangover = maxf(0.0, sim.hangover - 10.0)
+		sim.spend(1)
+		_apply_light()
+		_close()
+		_say("You walk a few laps of the park. It's %s now." % sim.time_text()))
+	if sim.stash.has("joint"):
+		_row(box, "Smoke a joint on a bench", "From your stash. Police sometimes walk through.", "Smoke", func() -> void:
+			var r := sim.consume("joint", true)
+			var t := String(r.text)
+			if rng.randf() < 0.12:
+				var fine := mini(w.wallet, 500)
+				w.wallet -= fine
+				t += " A police officer walks past and fines you $%d." % fine
+			_close()
+			_say(t))
+	if sim.slot >= 2:
+		_row(box, "The guy by the fountain", "\"Psst. Need anything?\"", "Talk", func() -> void:
+			_close()
+			_dealer_panel())
+
+
+func _dealer_panel() -> void:
+	var box := _open(520, "By the fountain")
+	box.add_child(UI.label("Banned substances show up in match-day drug tests for a few days.", 11, UI.WARN))
+	for id: String in ["joint", "vex", "blitz"]:
+		var it: Dictionary = LifeSim.ITEMS[id]
+		var idd := id
+		_row(box, "%s  ($%d)" % [String(it.name), int(it.cost)], String(it.get("desc", "")), "Buy", func() -> void:
+			var r := sim.buy_drug(idd)
+			_close()
+			_say(r if r != "" else "Into your stash (phone)."))
+
+
+func _phone() -> void:
+	var box := _open(560, "Phone")
+	box.add_child(UI.label("%s  -  wallet %s  -  stash: %s" % [sim.time_text().capitalize(), UI.money_text(w.wallet), sim.stash_text()], 12, UI.TEXT_DIM))
+	box.add_child(UI.label("Taxi", 14, UI.TEXT, 600))
+	for id: String in places:
+		if id in ["park", "dealer"]:
+			continue
+		var idd := id
+		var open := id == "home" or not Venues.IDS.has(id) or Venues.is_open(id, sim.slot)
+		_row(box, String(places[id].label), "" if open else "Closed now", "$20", func() -> void: _taxi_to(idd), not open)
+	if not sim.stash.is_empty():
+		box.add_child(UI.divider())
+		var flow := HFlowContainer.new()
+		flow.add_theme_constant_override("h_separation", 6)
+		for id2: String in sim.stash:
+			var i2 := id2
+			flow.add_child(UI.small_button("%s (%d)" % [String(LifeSim.ITEMS[id2].name), int(sim.stash[id2])], func() -> void:
+				var r := sim.consume(i2, true)
+				_close()
+				_say(String(r.text)), 0, "GhostButton"))
+		box.add_child(flow)
+
+
+func _taxi_to(id: String) -> void:
+	if w.wallet < 20:
+		_close()
+		_say("You can't afford the fare.")
+		return
+	w.wallet -= 20
+	if id == "home":
+		Game.venue = ""
+		sim.location = "home"
+		_go(Game.HOME_SCENE)
+	elif id == "arena" and sim.is_match_time() and Game.prepare_player_match():
+		_go(Game.MATCH_SCENE)
+	else:
+		Game.venue = id
+		sim.location = id
+		_go(Game.HOME_SCENE)
+
+
+func _pause_menu() -> void:
+	var box := _open(420, "Menu")
+	box.add_child(UI.label("%s  -  %s" % [sim.time_text().capitalize(), sim.match_text()], 13, UI.TEXT_DIM))
+	box.add_child(UI.button("Resume", _close, 0, "PrimaryButton"))
+	box.add_child(UI.button("Career hub", func() -> void: _go(Game.CAREER_SCENE), 0, "GhostButton"))
+	box.add_child(UI.button("Save and quit to main menu", func() -> void:
+		Game.save_player_career()
+		Game.goto(Game.MENU_SCENE), 0, "GhostButton"))
