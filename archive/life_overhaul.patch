diff --git a/tests/life_shot.gd b/tests/life_shot.gd
new file mode 100644
index 0000000..499ee7c
--- /dev/null
+++ b/tests/life_shot.gd
@@ -0,0 +1,69 @@
+extends Node
+## Screenshots of the city (day and night, walking and driving) and every venue.
+##   godot --path . res://tests/life_shot.tscn -- --test --out=<dir>
+func _ready() -> void:
+	var out := ""
+	for a in OS.get_cmdline_user_args():
+		if a.begins_with("--out="):
+			out = a.substr(6)
+	get_window().size = Vector2i(1600, 900)
+	Game.end_career()
+	Game.create_my_player("Nightlife", "Rifler", "Canada")
+	Game.start_career()
+	var w := Game.pworld
+	var sim := w.life().sim
+	w.wallet = 500000
+	w.life().buy("car")
+	w.life().buy("apartment")
+	sim.sync()
+	var cs: PackedScene = load("res://scenes/city.tscn")
+	for shot: Array in [["city_day_car", 1, false], ["city_night_car", 3, false], ["city_evening_walk", 2, true]]:
+		sim.slot = int(shot[1])
+		sim.drunk = 0.0
+		Game.city_spawn = "home"
+		Game.city_on_foot = bool(shot[2])
+		var c: City = cs.instantiate()
+		add_child(c)
+		await get_tree().process_frame
+		c.waypoint = "club"
+		c._update_gps()
+		for i in 40:
+			await get_tree().process_frame
+		get_viewport().get_texture().get_image().save_png("%s/%s.png" % [out, shot[0]])
+		if shot[0] == "city_day_car":
+			# Whole map.
+			c.cam.position_smoothing_enabled = false
+			c.cam.zoom = Vector2(0.36, 0.36)
+			c.cam.global_position = Vector2(City.MW, City.MH) * City.T * 0.5
+			c.set_process(false)
+			for i in 10:
+				await get_tree().process_frame
+			get_viewport().get_texture().get_image().save_png("%s/city_map.png" % out)
+		c.queue_free()
+		await get_tree().process_frame
+	var hs: PackedScene = load("res://scenes/home.tscn")
+	sim.drunk = 0.0
+	for id: String in Venues.IDS:
+		Game.venue = id
+		sim.slot = 3 if id in ["club", "bar"] else 1
+		var h: Home = hs.instantiate()
+		add_child(h)
+		await get_tree().process_frame
+		var vs := get_viewport().get_visible_rect().size
+		var z := minf(vs.x / (h.W * Home.CELL + 40.0), vs.y / (h.H * Home.CELL + 40.0))
+		h.cam.zoom = Vector2(z, z)
+		h.pos = Vector2(h.W, h.H) * Home.CELL * 0.5
+		h.cam.position_smoothing_enabled = false
+		for i in 20:
+			await get_tree().process_frame
+		get_viewport().get_texture().get_image().save_png("%s/venue_%s.png" % [out, id])
+		h.queue_free()
+		await get_tree().process_frame
+	Game.venue = ""
+	var h2: Home = hs.instantiate()
+	add_child(h2)
+	for i in 20:
+		await get_tree().process_frame
+	get_viewport().get_texture().get_image().save_png("%s/home_hud.png" % out)
+	Game.end_career()
+	get_tree().quit()
